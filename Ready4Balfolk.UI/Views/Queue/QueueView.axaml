<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Ready4Balfolk.UI.Views.Queue"
             xmlns:queueItems="using:Ready4Balfolk.Domain.Models.QueueItems"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
             x:Class="Ready4Balfolk.UI.Views.Queue.QueueView"
             x:DataType="local:QueueViewModel">
    <UserControl.Styles>
        <Style Selector="ListBoxItem.autoTrack">
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="ListBoxItem.autoTrack /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem.autoTrack:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem.autoTrack:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem.autoTrack:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem.autoTrack:selected:not(:focus) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem.autoTrack:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem.autoTrack:selected:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>
    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8"
            ClipToBounds="True">
        <Grid RowDefinitions="*,Auto" ClipToBounds="True">
            <!-- Queue ListBox -->
            <ListBox Grid.Row="0"
                     x:Name="QueueListBox"
                     ItemsSource="{Binding QueuedItems}"
                     SelectedItem="{Binding SelectedItem}"
                     SelectionMode="Single"
                     FontSize="13"
                     ClipToBounds="True"
                     DragDrop.AllowDrop="True"
                     KeyDown="OnQueueKeyDown">
                <ListBox.DataTemplates>
                    <!-- Track template -->
                    <DataTemplate DataType="queueItems:TrackQueueItem">
                        <Grid ColumnDefinitions="Auto,*,*,2*,60">
                            <PathIcon Grid.Column="0"
                                      Data="{StaticResource IconMusicNote}"
                                      Width="10" Height="10"
                                      Margin="0,0,6,0" />
                            <TextBlock Grid.Column="1" Text="{Binding Track.Dance}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Grid.Column="2" Text="{Binding Track.Artist}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Grid.Column="3" Text="{Binding Track.Title}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Grid.Column="4"
                                       Text="{Binding Track.Length, Converter={x:Static local:DurationFormatConverter.Instance}}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                    <!-- Stop marker template -->
                    <DataTemplate DataType="queueItems:StopQueueItem">
                        <Border Background="{DynamicResource StopMarkerBackground}" CornerRadius="2" Padding="4,2" Margin="-4,-2">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Column="0" Text="&#x25A0;"
                                           Foreground="{DynamicResource StopMarkerForeground}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Text="STOP — Playback will pause here"
                                           VerticalAlignment="Center"
                                           FontStyle="Italic"
                                           Opacity="0.8" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                    <!-- Delay marker template -->
                    <DataTemplate DataType="queueItems:DelayQueueItem">
                        <Border Background="{DynamicResource DelayMarkerBackground}" CornerRadius="2" Padding="4,2" Margin="-4,-2">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <PathIcon Grid.Column="0"
                                          Data="{StaticResource IconClock}"
                                          Width="10" Height="10"
                                          Foreground="{DynamicResource DelayMarkerForeground}"
                                          Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Text="DELAY — Playback will pause temporarily"
                                           VerticalAlignment="Center"
                                           FontStyle="Italic"
                                           Opacity="0.8" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding DelayDuration, Converter={x:Static local:DurationFormatConverter.Instance}}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="8,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                    <!-- Message marker template -->
                    <DataTemplate DataType="queueItems:MessageQueueItem">
                        <Border Background="{DynamicResource MessageMarkerBackground}" CornerRadius="2" Padding="4,2" Margin="-4,-2">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                <PathIcon Grid.Column="0"
                                          Data="{StaticResource IconEmail}"
                                          Width="10" Height="10"
                                          Foreground="{DynamicResource MessageMarkerForeground}"
                                          Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Text="MESSAGE —"
                                           VerticalAlignment="Center"
                                           FontStyle="Italic"
                                           Opacity="0.8"
                                           Margin="0,0,8,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Description}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Opacity="0.8" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding Duration, Converter={x:Static local:DurationFormatConverter.Instance}}"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"
                                           Margin="8,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                    <!-- Auto-queued track template (faded appearance, not draggable) -->
                    <DataTemplate DataType="queueItems:AutoTrackQueueItem">
                        <Border Background="{DynamicResource AutoTrackBackground}" CornerRadius="2" Padding="4,2" Margin="-4,-2">
                            <Grid ColumnDefinitions="Auto,*,*,2*,Auto,Auto,50">
                                <TextBlock Grid.Column="0" Text="&#x27F3;"
                                           Foreground="{DynamicResource AutoTrackForeground}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Text="{Binding TrackQueueItem.Track.Dance}"
                                           VerticalAlignment="Center"
                                           Opacity="0.6"
                                           FontStyle="Italic"
                                           Margin="0,0,8,0" />
                                <TextBlock Grid.Column="2" Text="{Binding TrackQueueItem.Track.Artist}"
                                           VerticalAlignment="Center"
                                           Opacity="0.6"
                                           FontStyle="Italic"
                                           Margin="0,0,8,0" />
                                <TextBlock Grid.Column="3" Text="{Binding TrackQueueItem.Track.Title}"
                                           VerticalAlignment="Center"
                                           Opacity="0.6"
                                           FontStyle="Italic"
                                           Margin="0,0,8,0" />
                                <!-- Refresh button -->
                                <Button Grid.Column="4"
                                        Click="OnRefreshAutoQueuedClick"
                                        ToolTip.Tip="Pick different random track"
                                        Padding="2"
                                        Margin="0,0,4,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Focusable="False">
                                    <PathIcon
                                        Data="{StaticResource IconAutoRepeat}"
                                        Width="12" Height="12"
                                        Foreground="{DynamicResource AutoTrackForeground}" />
                                </Button>
                                <!-- Pin button -->
                                <Button Grid.Column="5"
                                        Click="OnPinAutoQueuedClick"
                                        ToolTip.Tip="Keep this track"
                                        Padding="2"
                                        Margin="0,0,8,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Focusable="False">
                                    <PathIcon Data="{StaticResource IconPin}"
                                              Width="12" Height="12"
                                              Foreground="{DynamicResource AutoTrackForeground}" />
                                </Button>
                                <TextBlock Grid.Column="6"
                                           Text="{Binding TrackQueueItem.Track.Length, Converter={x:Static local:DurationFormatConverter.Instance}}"
                                           VerticalAlignment="Center"
                                           Opacity="0.6"
                                           FontStyle="Italic"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.DataTemplates>
            </ListBox>

            <!-- Drop indicator overlay -->
            <Canvas Grid.Row="0" IsHitTestVisible="False">
                <Border x:Name="DropIndicatorLine"
                        Height="3"
                        Background="{DynamicResource DropIndicatorBrush}"
                        CornerRadius="1.5"
                        IsVisible="False" />
            </Canvas>

            <!-- Status bar -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                    CornerRadius="4"
                    Padding="10,6"
                    Margin="0,8,0,0"
                    MinHeight="32">
                <Grid ColumnDefinitions="*,*">
                    <TextBlock Grid.Column="0"
                               Text="{Binding ItemCountText}"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding FinishTimeText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
