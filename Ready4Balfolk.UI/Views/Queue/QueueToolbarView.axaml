<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Ready4Balfolk.UI.Views.Queue"
             xmlns:res="using:Ready4Balfolk.UI.Resources"
             xmlns:controls="using:Ready4Balfolk.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="40"
             x:Class="Ready4Balfolk.UI.Views.Queue.QueueToolbarView"
             x:DataType="local:QueueViewModel">
    <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Click="OnToggleClick"
                ToolTip.Tip="{x:Static res:UiStrings.QueueToolbar_SwitchToHistory}"
                Padding="8"
                Focusable="False">
            <controls:ButtonContent Icon="{StaticResource IconHourglass}"
                                    Text="{x:Static res:UiStrings.QueueToolbar_HistoryLabel}"
                                    IconSize="16" />
        </Button>

        <Rectangle Width="1" Fill="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,4" />

        <Button Command="{Binding QueueRandomTrackCommand}"
                ToolTip.Tip="{x:Static res:UiStrings.QueueToolbar_QueueRandomTrack}"
                Padding="8"
                Focusable="False">
            <controls:ButtonContent Icon="{StaticResource IconDice}"
                                    Text="{x:Static res:UiStrings.QueueToolbar_RandomLabel}"
                                    IconSize="16" />
        </Button>

        <Rectangle Width="1" Fill="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,4" />

        <Button Command="{Binding EnqueueStopCommand}"
                ToolTip.Tip="{x:Static res:UiStrings.QueueToolbar_RequestStop}"
                Padding="8"
                Focusable="False">
            <controls:ButtonContent Icon="{StaticResource IconStop}"
                                    Text="{x:Static res:UiStrings.QueueToolbar_StopLabel}"
                                    IconSize="16" />
        </Button>
        <Button Command="{Binding EnqueueDelayCommand}"
                ToolTip.Tip="{x:Static res:UiStrings.QueueToolbar_RequestDelay}"
                Padding="8"
                Focusable="False">
            <controls:ButtonContent Icon="{StaticResource IconClock}"
                                    Text="{x:Static res:UiStrings.QueueToolbar_DelayLabel}"
                                    IconSize="16" />
        </Button>
        <Button Click="OnMessageClick"
                ToolTip.Tip="{x:Static res:UiStrings.QueueToolbar_RequestMessage}"
                Padding="8"
                Focusable="False">
            <controls:ButtonContent Icon="{StaticResource IconEmail}"
                                    Text="{x:Static res:UiStrings.QueueToolbar_MessageLabel}"
                                    IconSize="16" />
        </Button>

        <Rectangle Width="1" Fill="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,4" />

        <Button Command="{Binding RemoveSelectedCommand}"
                ToolTip.Tip="{x:Static res:UiStrings.QueueToolbar_RemoveSelected}"
                Padding="8"
                Focusable="False">
            <controls:ButtonContent Icon="{StaticResource IconClose}"
                                    Text="{x:Static res:UiStrings.QueueToolbar_RemoveLabel}"
                                    IconSize="16" />
        </Button>
        <Button Command="{Binding ClearQueueCommand}"
                ToolTip.Tip="{x:Static res:UiStrings.QueueToolbar_ClearQueue}"
                Padding="8"
                Focusable="False">
            <controls:ButtonContent Icon="{StaticResource IconDelete}"
                                    Text="{x:Static res:UiStrings.QueueToolbar_ClearLabel}"
                                    IconSize="16" />
        </Button>

        <Rectangle Width="1" Fill="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,4" />

        <Button Command="{Binding MoveSelectedUpCommand}"
                ToolTip.Tip="{x:Static res:UiStrings.Queue_MoveUp}"
                Padding="8"
                Focusable="False">
            <controls:ButtonContent Icon="{StaticResource IconArrowUp}"
                                    Text="{x:Static res:UiStrings.Queue_MoveUpLabel}"
                                    IconSize="16" />
        </Button>
        <Button Command="{Binding MoveSelectedDownCommand}"
                ToolTip.Tip="{x:Static res:UiStrings.Queue_MoveDown}"
                Padding="8"
                Focusable="False">
            <controls:ButtonContent Icon="{StaticResource IconArrowDown}"
                                    Text="{x:Static res:UiStrings.Queue_MoveDownLabel}"
                                    IconSize="16" />
        </Button>

    </StackPanel>
</UserControl>
