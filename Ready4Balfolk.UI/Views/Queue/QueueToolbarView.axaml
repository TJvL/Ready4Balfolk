<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Ready4Balfolk.UI.Views.Queue"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="40"
             x:Class="Ready4Balfolk.UI.Views.Queue.QueueToolbarView"
             x:DataType="local:QueueViewModel">
    <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Click="OnToggleClick"
                ToolTip.Tip="Switch to history"
                Padding="8"
                Focusable="False">
            <PathIcon Data="{StaticResource IconHourglass}"
                      Width="16" Height="16" />
        </Button>

        <Rectangle Width="1" Fill="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,4" />

        <Button Command="{Binding QueueRandomTrackCommand}"
                ToolTip.Tip="Queue random track"
                Padding="8"
                Focusable="False">
            <PathIcon Data="{StaticResource IconDice}"
                      Width="16" Height="16" />
        </Button>

        <Rectangle Width="1" Fill="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,4" />

        <Button Command="{Binding EnqueueStopCommand}"
                ToolTip.Tip="Request stop"
                Padding="8"
                Focusable="False">
            <PathIcon Data="{StaticResource IconStop}"
                      Width="16" Height="16" />
        </Button>
        <Button Command="{Binding EnqueueDelayCommand}"
                ToolTip.Tip="Request delay"
                Padding="8"
                Focusable="False">
            <PathIcon Data="{StaticResource IconClock}"
                      Width="16" Height="16" />
        </Button>
        <Button Click="OnMessageClick"
                ToolTip.Tip="Request message"
                Padding="8"
                Focusable="False">
            <PathIcon Data="{StaticResource IconEmail}"
                      Width="16" Height="16" />
        </Button>

        <Rectangle Width="1" Fill="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,4" />

        <Button Command="{Binding RemoveSelectedCommand}"
                ToolTip.Tip="Remove selected item"
                Padding="8"
                Focusable="False">
            <PathIcon Data="{StaticResource IconClose}"
                      Width="16" Height="16" />
        </Button>
        <Button Command="{Binding ClearQueueCommand}"
                ToolTip.Tip="Clear queue"
                Padding="8"
                Focusable="False">
            <PathIcon Data="{StaticResource IconDelete}"
                      Width="16" Height="16" />
        </Button>

    </StackPanel>
</UserControl>
