<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="using:Ready4Balfolk.UI.Resources"
             xmlns:controls="using:Ready4Balfolk.UI.Controls"
             xmlns:wizard="using:Ready4Balfolk.UI.Views.Wizard"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="480"
             x:Class="Ready4Balfolk.UI.Views.Wizard.DanceListStepView"
             x:DataType="wizard:DanceListStepViewModel">
    <controls:LoadingContainer IsLoading="{CompiledBinding IsFetching}">
        <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="{CompiledBinding SummaryText}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="{CompiledBinding OriginText}" Opacity="0.7" />

            <TextBlock Text="{x:Static res:UiStrings.Wizard_DanceList_Detail}"
                       TextWrapping="Wrap"
                       Opacity="0.7" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button AutomationProperties.AutomationId="wizard.fetch-dances"
                        Command="{CompiledBinding FetchCommand}"
                        Content="{x:Static res:UiStrings.Wizard_DanceList_Fetch}" />
                <Button AutomationProperties.AutomationId="wizard.import-dances"
                        Click="OnImportClick"
                        Content="{x:Static res:UiStrings.Wizard_DanceList_Import}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{x:Static res:UiStrings.Wizard_DanceList_Source}"
                           VerticalAlignment="Center"
                           Opacity="0.7" />
                <Button Click="OnSourceLinkClick"
                        Content="{CompiledBinding SourceUri}"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource SystemAccentColor}"
                        Cursor="Hand" />
            </StackPanel>
        </StackPanel>
    </controls:LoadingContainer>
</UserControl>
