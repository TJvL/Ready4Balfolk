<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:rxui="http://reactiveui.net"
        xmlns:res="using:Ready4Balfolk.UI.Resources"
        xmlns:wizard="using:Ready4Balfolk.UI.Views.Wizard"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="900"
        x:Class="Ready4Balfolk.UI.Views.Wizard.SetupWizardWindow"
        x:DataType="wizard:SetupWizardViewModel"
        Title="{x:Static res:UiStrings.Wizard_Title}"
        Icon="/Assets/icon.ico"
        Width="1400"
        Height="900"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,16">
            <TextBlock Text="{CompiledBinding ProgressText}" FontSize="12" Opacity="0.6" />
            <TextBlock Text="{CompiledBinding CurrentStep.Title}" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="{CompiledBinding CurrentStep.Explanation}"
                       TextWrapping="Wrap"
                       Opacity="0.8"
                       Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Content="{x:Static res:UiStrings.Wizard_Back}"
                    Command="{CompiledBinding BackCommand}"
                    IsVisible="{CompiledBinding !IsFirstStep}"
                    MinWidth="100" />
            <!-- The accent class is provided by FluentAvalonia at runtime, so this is a false positive. -->
            <!-- ReSharper disable once Xaml.StyleClassNotFound -->
            <Button Content="{CompiledBinding ContinueLabel}"
                    Command="{CompiledBinding ContinueCommand}"
                    Classes="accent"
                    MinWidth="100"
                    IsDefault="True" />
        </StackPanel>

        <rxui:ViewModelViewHost ViewModel="{CompiledBinding CurrentStep}" />
    </DockPanel>
</Window>
