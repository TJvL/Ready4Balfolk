<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:discovery="using:Ready4Balfolk.UI.Views.Discovery"
             xmlns:wizard="using:Ready4Balfolk.UI.Views.Wizard"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="480"
             x:Class="Ready4Balfolk.UI.Views.Wizard.DiscoveryStepView"
             x:DataType="wizard:DiscoveryStepViewModel">
    <discovery:DiscoveryView DataContext="{CompiledBinding Discovery}" />
</UserControl>
