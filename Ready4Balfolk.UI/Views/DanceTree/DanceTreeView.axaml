<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:local="using:Ready4Balfolk.UI.Views.DanceTree"
             xmlns:res="using:Ready4Balfolk.UI.Resources"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Ready4Balfolk.UI.Views.DanceTree.DanceTreeView"
             x:DataType="local:DanceTreeViewModel">
    <UserControl.Resources>
        <local:BoolToStringConverter x:Key="EditConfirmTooltip" TrueValue="{x:Static res:UiStrings.DanceTree_Confirm}" FalseValue="{x:Static res:UiStrings.DanceTree_Edit}" />
        <local:BoolToStringConverter x:Key="DeleteCancelTooltip" TrueValue="{x:Static res:UiStrings.DanceTree_Cancel}" FalseValue="{x:Static res:UiStrings.DanceTree_Delete}" />
        <local:MarkedBrushConverter x:Key="MarkedBrushConverter" />
    </UserControl.Resources>
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    </UserControl.KeyBindings>
    <TreeView x:Name="DanceTreeControl"
              ItemsSource="{Binding DanceTreeDisplayRoot}"
              SelectedItem="{Binding SelectedTreeItem}">
        <TreeView.Styles>
            <Style Selector="TreeViewItem">
                <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, FallbackValue=True}" />
            </Style>
        </TreeView.Styles>
        <TreeView.DataTemplates>
            <!-- Template for DanceCategoryNode (branches) -->
            <TreeDataTemplate DataType="local:DanceCategoryNode" ItemsSource="{Binding Items}">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <!-- Mark button (dice) -->
                    <Button Grid.Column="0" Padding="2"
                            Background="Transparent" BorderThickness="0"
                            ToolTip.Tip="{x:Static res:UiStrings.DanceTree_MarkRootRandom}"
                            Command="{Binding MarkAsRootCommand}"
                            Focusable="False">
                        <PathIcon Data="{StaticResource IconDice}"
                                  Width="14" Height="14"
                                  Foreground="{Binding IsMarked, Converter={StaticResource MarkedBrushConverter}}" />
                    </Button>
                    <!-- Display mode: read-only text -->
                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               IsVisible="{Binding !IsEditing}" />
                    <!-- Edit mode: editable name -->
                    <TextBox Grid.Column="1" Text="{Binding Name}"
                             BorderThickness="0" Background="Transparent"
                             FontWeight="SemiBold" Padding="0" MinHeight="0"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             IsVisible="{Binding IsEditing}"
                             AttachedToVisualTree="OnEditTextBoxAttached"
                             KeyDown="OnEditKeyDown" />
                    <!-- Edit mode: weight (not for root) -->
                    <NumericUpDown Grid.Column="2"
                                   Value="{Binding Weight, Converter={x:Static local:WeightConverter.Instance}}"
                                   Minimum="0" FormatString="0"
                                   IsVisible="{Binding IsEditing}"
                                   Width="100" Margin="4,0"
                                   VerticalAlignment="Center"
                                   KeyDown="OnEditKeyDown" />
                    <!-- Action buttons (visible when selected) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2"
                                IsVisible="{Binding $parent[TreeViewItem].IsSelected}">
                        <!-- Add Category (hidden when editing) -->
                        <Button Padding="4,2"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip.Tip="{x:Static res:UiStrings.DanceTree_AddCategory}"
                                Command="{Binding AddCategoryCommand}"
                                IsVisible="{Binding !IsEditing}"
                                Focusable="False">
                            <PathIcon Data="{StaticResource IconMarked}"
                                      Width="14" Height="14" />
                        </Button>
                        <!-- Add Dance (not for root, hidden when editing) -->
                        <Button Padding="4,2"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip.Tip="{x:Static res:UiStrings.DanceTree_AddDance}"
                                Command="{Binding AddDanceCommand}"
                                Focusable="False">
                            <Button.IsVisible>
                                <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                    <Binding Path="!IsRoot" />
                                    <Binding Path="!IsEditing" />
                                </MultiBinding>
                            </Button.IsVisible>
                            <PathIcon
                                Data="{StaticResource IconLeaf}"
                                Width="14" Height="14" />
                        </Button>
                        <!-- Edit/Confirm toggle (not for root) -->
                        <Button Padding="4,2"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip.Tip="{Binding IsEditing, Converter={StaticResource EditConfirmTooltip}}"
                                Command="{Binding ToggleEditingCommand}"
                                IsVisible="{Binding !IsRoot}"
                                Focusable="False">
                            <Panel>
                                <PathIcon Data="{StaticResource IconPencil}"
                                          Width="14" Height="14"
                                          IsVisible="{Binding !IsEditing}" />
                                <PathIcon Data="{StaticResource IconCheck}"
                                          Width="14" Height="14"
                                          IsVisible="{Binding IsEditing}" />
                            </Panel>
                        </Button>
                        <!-- Delete / Cancel (not for root) -->
                        <Button Padding="4,2"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip.Tip="{Binding IsEditing, Converter={StaticResource DeleteCancelTooltip}}"
                                Command="{Binding DeleteOrCancelCommand}"
                                IsVisible="{Binding !IsRoot}"
                                Focusable="False">
                            <Panel>
                                <PathIcon Data="{StaticResource IconDelete}"
                                          Width="14" Height="14"
                                          IsVisible="{Binding !IsEditing}" />
                                <PathIcon Data="{StaticResource IconClose}"
                                          Width="14" Height="14"
                                          IsVisible="{Binding IsEditing}" />
                            </Panel>
                        </Button>
                    </StackPanel>
                </Grid>
            </TreeDataTemplate>
            <!-- Template for DanceItem (leaves) -->
            <DataTemplate DataType="local:DanceItem">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <!-- Mark button (dice) -->
                    <Button Grid.Column="0" Padding="2"
                            Background="Transparent" BorderThickness="0"
                            ToolTip.Tip="{x:Static res:UiStrings.DanceTree_MarkRandom}"
                            Command="{Binding MarkAsRootCommand}"
                            Focusable="False">
                        <PathIcon Data="{StaticResource IconDice}"
                                  Width="14" Height="14"
                                  Foreground="{Binding IsMarked, Converter={StaticResource MarkedBrushConverter}}" />
                    </Button>
                    <!-- Display mode: read-only text -->
                    <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                               VerticalAlignment="Center"
                               IsVisible="{Binding !IsEditing}" />
                    <!-- Edit mode: editable name -->
                    <TextBox Grid.Column="1" Text="{Binding Name}"
                             BorderThickness="0" Background="Transparent"
                             Padding="0" MinHeight="0"
                             VerticalAlignment="Center"
                             VerticalContentAlignment="Center"
                             IsVisible="{Binding IsEditing}"
                             AttachedToVisualTree="OnEditTextBoxAttached"
                             KeyDown="OnEditKeyDown" />
                    <!-- Edit mode: weight -->
                    <NumericUpDown Grid.Column="2"
                                   Value="{Binding Weight, Converter={x:Static local:WeightConverter.Instance}}"
                                   Minimum="0" FormatString="0"
                                   IsVisible="{Binding IsEditing}"
                                   Width="100" Margin="4,0"
                                   VerticalAlignment="Center"
                                   KeyDown="OnEditKeyDown" />
                    <!-- Action buttons (visible when selected) -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2"
                                IsVisible="{Binding $parent[TreeViewItem].IsSelected}">
                        <!-- Edit/Confirm toggle -->
                        <Button Padding="4,2"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip.Tip="{Binding IsEditing, Converter={StaticResource EditConfirmTooltip}}"
                                Command="{Binding ToggleEditingCommand}"
                                Focusable="False">
                            <Panel>
                                <PathIcon Data="{StaticResource IconPencil}"
                                          Width="14" Height="14"
                                          IsVisible="{Binding !IsEditing}" />
                                <PathIcon Data="{StaticResource IconCheck}"
                                          Width="14" Height="14"
                                          IsVisible="{Binding IsEditing}" />
                            </Panel>
                        </Button>
                        <!-- Delete / Cancel -->
                        <Button Padding="4,2"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTip.Tip="{Binding IsEditing, Converter={StaticResource DeleteCancelTooltip}}"
                                Command="{Binding DeleteOrCancelCommand}"
                                Focusable="False">
                            <Panel>
                                <PathIcon Data="{StaticResource IconDelete}"
                                          Width="14" Height="14"
                                          IsVisible="{Binding !IsEditing}" />
                                <PathIcon Data="{StaticResource IconClose}"
                                          Width="14" Height="14"
                                          IsVisible="{Binding IsEditing}" />
                            </Panel>
                        </Button>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </TreeView.DataTemplates>
    </TreeView>
</UserControl>
