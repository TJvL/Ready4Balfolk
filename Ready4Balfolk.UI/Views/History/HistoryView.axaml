<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Ready4Balfolk.UI.Views.History"
             xmlns:controls="using:Ready4Balfolk.UI.Controls"
             xmlns:res="using:Ready4Balfolk.UI.Resources"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Ready4Balfolk.UI.Views.History.HistoryView"
             x:DataType="local:HistoryViewModel">
    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8"
            ClipToBounds="True">
    <controls:LoadingContainer IsLoading="{Binding IsLoading}">
    <Grid RowDefinitions="*,Auto" ClipToBounds="True">
        <ListBox Grid.Row="0"
                 x:Name="HistoryList"
                 AutomationProperties.AutomationId="history.items"
                 ItemsSource="{Binding Items}"
                 SelectionMode="Single"
                 FontSize="18"
                 ClipToBounds="True">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="IsHitTestVisible" Value="False" />
                </Style>
            </ListBox.Styles>
            <ListBox.DataTemplates>
                <DataTemplate DataType="local:HistoryItemViewModel">
                    <Panel>
                        <!-- Where the night begins and ends, in the order it happened rather than
                             as a heading somewhere else. -->
                        <TextBlock AutomationProperties.AutomationId="history.night-marker"
                                   Text="{Binding MarkerText}"
                                   IsVisible="{Binding IsMarker}"
                                   FontStyle="Italic"
                                   Opacity="0.7"
                                   Margin="0,4" />

                        <Grid ColumnDefinitions="*,52,52,60,72" IsVisible="{Binding !IsMarker}">
                            <TextBlock Grid.Column="0" Text="{Binding Description}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding StartedAtFormatted}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="8,0,0,0"
                                       Opacity="0.6"
                                       ToolTip.Tip="{x:Static res:UiStrings.History_StartedAt}" />
                            <TextBlock Grid.Column="2" Text="{Binding FinishedAtFormatted}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="8,0,0,0"
                                       Opacity="0.6"
                                       ToolTip.Tip="{x:Static res:UiStrings.History_FinishedAt}" />
                            <TextBlock Grid.Column="3" Text="{Binding DurationFormatted}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Margin="8,0" />
                            <TextBlock Grid.Column="4" Text="{Binding Status}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Opacity="0.6" />
                        </Grid>
                    </Panel>
                </DataTemplate>
            </ListBox.DataTemplates>
        </ListBox>

        <Border Grid.Row="1"
                Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                CornerRadius="4"
                Padding="10,6"
                Margin="0,8,0,0"
                MinHeight="32">
            <!-- Which night, and how much of it. The total that used to sit on the right counted a
                 skipped track as its whole length, so it was not the time anybody danced. -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           AutomationProperties.AutomationId="history.showing"
                           Text="{Binding ShowingText}"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           FontSize="18"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding ItemCountText}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="18"
                           Opacity="0.7"
                           Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
            </Grid>
        </Border>
    </Grid>
    </controls:LoadingContainer>
    </Border>
</UserControl>
