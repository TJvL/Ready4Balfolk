<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Ready4Balfolk.UI.Views.History"
             xmlns:res="using:Ready4Balfolk.UI.Resources"
             xmlns:controls="using:Ready4Balfolk.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="40"
             x:Class="Ready4Balfolk.UI.Views.History.HistoryToolbarView"
             x:DataType="local:HistoryViewModel">
    <StackPanel Orientation="Horizontal" Spacing="4">
        <Button AutomationProperties.AutomationId="history.show-queue"
                Click="OnToggleClick"
                ToolTip.Tip="{x:Static res:UiStrings.HistoryToolbar_SwitchToQueue}"
                Padding="8"
                Focusable="False">
            <controls:ButtonContent Icon="{StaticResource IconMenu}"
                                    Text="{x:Static res:UiStrings.HistoryToolbar_QueueLabel}"
                                    IconSize="16" />
        </Button>

        <Rectangle Width="1" Fill="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,4" />

        <!-- Which evening is being read. Nights are kept rather than lost, so this is how a filed
             one is reached, exported or thrown away. -->
        <ComboBox AutomationProperties.AutomationId="history.nights"
                  ItemsSource="{Binding Nights}"
                  SelectedItem="{Binding SelectedNight, Mode=TwoWay}"
                  ToolTip.Tip="{x:Static res:UiStrings.History_Showing}"
                  MinWidth="180"
                  VerticalAlignment="Center">
            <ComboBox.ItemTemplate>
                <DataTemplate DataType="local:NightOption">
                    <TextBlock Text="{Binding Label}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Button AutomationProperties.AutomationId="history.export"
                Click="OnExportClick"
                ToolTip.Tip="{x:Static res:UiStrings.HistoryToolbar_ExportHistory}"
                IsEnabled="{Binding HasItems}"
                Padding="8"
                Focusable="False">
            <controls:ButtonContent Icon="{StaticResource IconDownload}"
                                    Text="{x:Static res:UiStrings.HistoryToolbar_ExportLabel}"
                                    IconSize="16" />
        </Button>
        <Button AutomationProperties.AutomationId="history.new-night"
                Command="{Binding StartNewNightCommand}"
                ToolTip.Tip="{x:Static res:UiStrings.HistoryToolbar_NewNight}"
                Padding="8"
                Focusable="False">
            <controls:ButtonContent Icon="{StaticResource IconRestart}"
                                    Text="{x:Static res:UiStrings.HistoryToolbar_NewNightLabel}"
                                    IconSize="16" />
        </Button>
        <Button AutomationProperties.AutomationId="history.delete-night"
                Command="{Binding DeleteNightCommand}"
                ToolTip.Tip="{x:Static res:UiStrings.HistoryToolbar_DeleteNight}"
                Padding="8"
                Focusable="False">
            <controls:ButtonContent Icon="{StaticResource IconDelete}"
                                    Text="{x:Static res:UiStrings.HistoryToolbar_DeleteLabel}"
                                    IconSize="16" />
        </Button>
    </StackPanel>
</UserControl>
