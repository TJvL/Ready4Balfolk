<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Ready4Balfolk.UI.Views.History"
             xmlns:res="using:Ready4Balfolk.UI.Resources"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="40"
             x:Class="Ready4Balfolk.UI.Views.History.HistoryToolbarView"
             x:DataType="local:HistoryViewModel">
    <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Click="OnToggleClick"
                ToolTip.Tip="{x:Static res:UiStrings.HistoryToolbar_SwitchToQueue}"
                Padding="8"
                Focusable="False">
            <PathIcon Data="{StaticResource IconMenu}"
                      Width="16" Height="16" />
        </Button>

        <Rectangle Width="1" Fill="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,4" />

        <Button Click="OnExportClick"
                ToolTip.Tip="{x:Static res:UiStrings.HistoryToolbar_ExportHistory}"
                IsEnabled="{Binding HasItems}"
                Padding="8"
                Focusable="False">
            <PathIcon Data="{StaticResource IconDownload}"
                      Width="16" Height="16" />
        </Button>
        <Button Command="{Binding ClearHistoryCommand}"
                ToolTip.Tip="{x:Static res:UiStrings.HistoryToolbar_ClearHistory}"
                Padding="8"
                Focusable="False">
            <PathIcon Data="{StaticResource IconDelete}"
                      Width="16" Height="16" />
        </Button>
    </StackPanel>
</UserControl>
