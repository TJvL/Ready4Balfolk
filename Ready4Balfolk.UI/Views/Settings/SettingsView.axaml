<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Ready4Balfolk.UI.Views.Settings"
             xmlns:danceTree="using:Ready4Balfolk.UI.Views.DanceTree"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Ready4Balfolk.UI.Views.Settings.SettingsView"
             x:DataType="local:SettingsViewModel">
    <ScrollViewer>
        <StackPanel Spacing="16" Margin="16">
            <StackPanel Spacing="8">
                <TextBlock Text="Music Directory" />
                <Grid ColumnDefinitions="*, Auto">
                    <TextBox Grid.Column="0"
                             Text="{Binding MusicDirectoryPath, Mode=TwoWay}"
                             Watermark="Select a directory..."
                             IsReadOnly="True" />
                    <Button Grid.Column="1"
                            Content="Browse..."
                            Margin="8,0,0,0"
                            Click="OnBrowseButtonClick" />
                </Grid>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Maximum Queue Items" />
                <NumericUpDown Value="{Binding MaxQueueItems, Mode=TwoWay, Converter={x:Static danceTree:WeightConverter.Instance}}"
                               Minimum="1"
                               Maximum="100"
                               Increment="1"
                               Width="120"
                               HorizontalAlignment="Left" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Delay Duration (seconds)" />
                <NumericUpDown Value="{Binding DelaySeconds, Mode=TwoWay, Converter={x:Static danceTree:WeightConverter.Instance}}"
                               Minimum="1"
                               Maximum="300"
                               Increment="5"
                               Width="120"
                               HorizontalAlignment="Left" />
                <TextBlock Text="Used for 'Request Delay' - pauses playback for this duration"
                           FontSize="11"
                           Opacity="0.6" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Presentation Displays" />
                <NumericUpDown Value="{Binding PresentationDisplayCount, Mode=TwoWay, Converter={x:Static danceTree:WeightConverter.Instance}}"
                               Minimum="0"
                               Maximum="10"
                               Increment="1"
                               Width="120"
                               HorizontalAlignment="Left"
                               Focusable="False" />
                <TextBlock Text="Number of presentation windows to show (0 = disabled)"
                           FontSize="11"
                           Opacity="0.6" />
            </StackPanel>

            <StackPanel Spacing="8">
                <CheckBox Content="Auto-queue random track during playback"
                          IsChecked="{Binding AutoQueueRandomTrack, Mode=TwoWay}"
                          Focusable="False" />
                <TextBlock
                    Text="Automatically adds a random track when playing. Removed when manually adding items."
                    FontSize="11"
                    Opacity="0.6" />
            </StackPanel>

            <StackPanel Spacing="8">
                <CheckBox Content="Allow duplicate tracks in queue in the same session"
                          IsChecked="{Binding AllowDuplicateTracksInQueue, Mode=TwoWay}"
                          Focusable="False" />
                <TextBlock
                    Text="When disabled, tracks that are currently playing, in the queue, or have already played this session cannot be added again."
                    FontSize="11"
                    Opacity="0.6"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <CheckBox Content="Confirm before skip, clear, and restart"
                          IsChecked="{Binding RequirePlaybackConfirmation, Mode=TwoWay}"
                          Focusable="False" />
                <TextBlock
                    Text="Show a confirmation dialog before skipping to the next item, clearing the current track, or restarting playback"
                    FontSize="11"
                    Opacity="0.6"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="Theme" />
                <ComboBox ItemsSource="{Binding AvailableThemes}"
                          SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                          Width="120"
                          HorizontalAlignment="Left"
                          Focusable="False" />
                <TextBlock Text="Choose between Auto (follows system), Light, or Dark theme"
                           FontSize="11"
                           Opacity="0.6" />
            </StackPanel>

            <!-- Troubleshooting section -->
            <StackPanel Spacing="8" Margin="0,16,0,0">
                <TextBlock Text="Troubleshooting" FontSize="18" FontWeight="SemiBold" />
                <Button Content="Export Log File"
                        Click="OnExportLogClick"
                        HorizontalAlignment="Left"
                        Focusable="False" />
                <TextBlock Text="Save the application log file for troubleshooting or bug reports"
                           FontSize="11"
                           Opacity="0.6" />
            </StackPanel>

            <!-- Version info -->
            <TextBlock Text="{Binding AppVersion, StringFormat='Version {0}'}"
                       FontSize="11"
                       Opacity="0.5"
                       Margin="0,24,0,0"
                       HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
