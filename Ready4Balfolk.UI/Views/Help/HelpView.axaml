<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="https://github.com/whistyun/Markdown.Avalonia.Tight"
             xmlns:local="using:Ready4Balfolk.UI.Views.Help"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Ready4Balfolk.UI.Views.Help.HelpView"
             x:DataType="local:HelpViewModel">
    <md:MarkdownScrollViewer Source="avares://Ready4Balfolk.UI/Views/Help/help.md" />
</UserControl>
