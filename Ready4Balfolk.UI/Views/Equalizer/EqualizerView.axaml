<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Ready4Balfolk.UI.Views.Equalizer"
             xmlns:conv="using:Ready4Balfolk.UI.Converters"
             xmlns:res="using:Ready4Balfolk.UI.Resources"
             xmlns:settings="using:Ready4Balfolk.Domain.Models.Settings"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="260"
             x:Class="Ready4Balfolk.UI.Views.Equalizer.EqualizerView"
             x:DataType="local:EqualizerViewModel">
    <UserControl.Resources>
        <conv:BoolToStringConverter x:Key="EnabledLabelConverter"
                                         TrueValue="{x:Static res:UiStrings.Equalizer_On}"
                                         FalseValue="{x:Static res:UiStrings.Equalizer_Off}" />
    </UserControl.Resources>
    <Expander IsExpanded="{Binding IsExpanded}"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch">
        <Expander.Header>
            <!-- State on the header, so an equalizer left engaged from last night is visible
                 without opening the panel. -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Static res:UiStrings.Equalizer_Title}"
                           FontWeight="Bold"
                           VerticalAlignment="Center" />
                <Border Background="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                        CornerRadius="4"
                        Padding="6,1"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsAvailable}">
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               Text="{Binding Enabled, Converter={StaticResource EnabledLabelConverter}}" />
                </Border>
            </StackPanel>
        </Expander.Header>

        <Grid RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,8,0,0">
            <!-- BASS_FX missing: the panel stays but does nothing, playback is unaffected -->
            <TextBlock Grid.Row="0"
                       Text="{x:Static res:UiStrings.Equalizer_Unavailable}"
                       Opacity="0.6"
                       Margin="0,0,0,8"
                       IsVisible="{Binding !IsAvailable}" />

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Spacing="16"
                        Margin="0,0,0,8"
                        IsEnabled="{Binding IsAvailable}">
                <CheckBox Content="{x:Static res:UiStrings.Equalizer_Enable}"
                          IsChecked="{Binding Enabled}" />
                <Button Content="{x:Static res:UiStrings.Equalizer_Reset}"
                        Command="{Binding ResetToFlatCommand}"
                        Focusable="False" />
            </StackPanel>

            <!-- Band sliders -->
            <ItemsControl Grid.Row="2"
                          ItemsSource="{Binding Bands}"
                          Margin="0,0,0,8"
                          IsEnabled="{Binding IsAvailable}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:EqualizerBandViewModel">
                        <StackPanel HorizontalAlignment="Center">
                            <Slider Orientation="Vertical"
                                    Height="120"
                                    HorizontalAlignment="Center"
                                    Minimum="{x:Static settings:EqualizerSettings.MinimumGainDecibels}"
                                    Maximum="{x:Static settings:EqualizerSettings.MaximumGainDecibels}"
                                    TickFrequency="3"
                                    TickPlacement="Outside"
                                    Value="{Binding Gain}"
                                    ToolTip.Tip="{Binding Gain, StringFormat={}{0:+0.0;-0.0;0.0} dB}" />
                            <TextBlock Text="{Binding Label}"
                                       FontSize="11"
                                       Opacity="0.7"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="3"
                  ColumnDefinitions="Auto,*,Auto"
                  RowDefinitions="Auto,Auto"
                  IsEnabled="{Binding IsAvailable}">
                <CheckBox Grid.Row="0" Grid.Column="0"
                          Content="{x:Static res:UiStrings.Equalizer_LowCut}"
                          IsChecked="{Binding LowCutEnabled}"
                          MinWidth="110" />
                <Slider Grid.Row="0" Grid.Column="1"
                        Minimum="{x:Static settings:EqualizerSettings.MinimumLowCutHertz}"
                        Maximum="{x:Static settings:EqualizerSettings.MaximumLowCutHertz}"
                        Value="{Binding LowCutHertz}"
                        IsEnabled="{Binding LowCutEnabled}"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Row="0" Grid.Column="2"
                           Text="{Binding LowCutHertz, StringFormat={}{0:0} Hz}"
                           VerticalAlignment="Center"
                           MinWidth="52"
                           TextAlignment="Right" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{x:Static res:UiStrings.Equalizer_Preamp}"
                           VerticalAlignment="Center" />
                <Slider Grid.Row="1" Grid.Column="1"
                        Minimum="{x:Static settings:EqualizerSettings.MinimumGainDecibels}"
                        Maximum="{x:Static settings:EqualizerSettings.MaximumGainDecibels}"
                        Value="{Binding PreampDecibels}"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Grid.Column="2"
                           Text="{Binding PreampDecibels, StringFormat={}{0:+0.0;-0.0;0.0} dB}"
                           VerticalAlignment="Center"
                           MinWidth="52"
                           TextAlignment="Right" />
            </Grid>
        </Grid>
    </Expander>
</UserControl>
