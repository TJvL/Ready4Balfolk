<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:confirmation="clr-namespace:Ready4Balfolk.UI.Views.Dialogs.Confirmation"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
        x:Class="Ready4Balfolk.UI.Views.Dialogs.Confirmation.ConfirmationDialogView"
        x:DataType="confirmation:ConfirmationDialogViewModel"
        Title="{CompiledBinding Title}"
        Width="400"
        SizeToContent="Height"
        MaxHeight="600"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <Grid Margin="20" RowDefinitions="*,Auto">
        <!-- The window follows the question rather than the question being cut to fit the window:
             a long track name, or a Dutch line that runs longer than the English, is still read to
             the end. The cap is a stop on a window growing without limit, at the same figure the
             missing folders dialog uses; past it the question scrolls, which is worse to read than
             a taller window and better than a window with no bottom to it. Nothing the application
             asks comes near it today. -->
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
            <TextBlock Text="{CompiledBinding Message}"
                       TextWrapping="Wrap" />
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="1"
                    Margin="0,20,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <!-- The return key, the focus on open and the accent all follow ConfirmIsSafe: a
                 question that throws something away must not be the one a reflex answers yes to,
                 and it must not be the inviting button either. Escape stays on cancel throughout. -->
            <!-- The accent class is provided by FluentAvalonia at runtime, so these are false positives. -->
            <!-- ReSharper disable once Xaml.StyleClassNotFound -->
            <Button x:Name="CancelButton"
                    AutomationProperties.AutomationId="dialog.cancel"
                    Content="{CompiledBinding CancelText}"
                    Command="{CompiledBinding CancelCommand}"
                    MinWidth="80"
                    Classes.accent="{CompiledBinding !ConfirmIsSafe}"
                    IsDefault="{CompiledBinding !ConfirmIsSafe}"
                    IsCancel="True" />
            <!-- ReSharper disable once Xaml.StyleClassNotFound -->
            <Button x:Name="ConfirmButton"
                    AutomationProperties.AutomationId="dialog.confirm"
                    Content="{CompiledBinding ConfirmText}"
                    Command="{CompiledBinding ConfirmCommand}"
                    MinWidth="80"
                    Classes.accent="{CompiledBinding ConfirmIsSafe}"
                    IsDefault="{CompiledBinding ConfirmIsSafe}" />
        </StackPanel>
    </Grid>
</Window>