<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:confirmation="clr-namespace:Ready4Balfolk.UI.Views.Dialogs.Confirmation"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="200"
        x:Class="Ready4Balfolk.UI.Views.Dialogs.Confirmation.ConfirmationDialogView"
        x:DataType="confirmation:ConfirmationDialogViewModel"
        Title="{CompiledBinding Title}"
        Width="400"
        Height="150"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <Grid Margin="20" RowDefinitions="*,Auto">
        <!-- Message -->
        <TextBlock Grid.Row="0"
                   Text="{CompiledBinding Message}"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />

        <!-- Buttons -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Content="{CompiledBinding CancelText}"
                    Command="{CompiledBinding CancelCommand}"
                    MinWidth="80"
                    IsCancel="True" />
            <!-- The accent class is provided by FluentAvalonia at runtime, so these are false positives. -->
            <!-- ReSharper disable once Xaml.StyleClassNotFound -->
            <Button x:Name="ConfirmButton"
                    Content="{CompiledBinding ConfirmText}"
                    Command="{CompiledBinding ConfirmCommand}"
                    MinWidth="80"
                    Classes="accent"
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>