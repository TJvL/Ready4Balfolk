<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:editTrack="clr-namespace:Ready4Balfolk.UI.Views.Dialogs.EditTrack"
        xmlns:review="clr-namespace:Ready4Balfolk.UI.Views.Review"
        xmlns:equalizer="clr-namespace:Ready4Balfolk.UI.Views.Equalizer"
        xmlns:settings="using:Ready4Balfolk.Domain.Models.Settings"
        xmlns:res="using:Ready4Balfolk.UI.Resources"
        mc:Ignorable="d" d:DesignWidth="460" d:DesignHeight="720"
        x:Class="Ready4Balfolk.UI.Views.Dialogs.EditTrack.EditTrackDialogView"
        x:DataType="editTrack:EditTrackDialogViewModel"
        Title="{x:Static res:UiStrings.EditTrack_WindowTitle}"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <Window.Styles>
        <Style Selector="Button.match">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <!-- Focus stays in the box being typed into: these are what the typing found, walked
                 with the arrows and taken with Enter. A match that could take the caret would end
                 the search that produced it. -->
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="Button.match.highlighted">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="20" Spacing="12">
        <StackPanel Spacing="4">
            <TextBlock Text="{x:Static res:UiStrings.Discovery_FieldDance}" />
            <TextBox x:Name="DanceBox"
                     AutomationProperties.AutomationId="edit-track.dance"
                     AutomationProperties.Name="{x:Static res:UiStrings.Discovery_FieldDance}"
                     Text="{CompiledBinding Dance}" />
            <!-- Inline rather than a Popup: a popup steals focus from the box being typed into.
                 Same reasoning as the review row's picker. -->
            <Border IsVisible="{CompiledBinding IsPickerOpen}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    MaxHeight="180">
                <ScrollViewer>
                    <ItemsControl x:Name="MatchList" ItemsSource="{CompiledBinding DanceMatches}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="review:DanceMatch">
                                <Button Classes="match"
                                        Classes.highlighted="{Binding IsHighlighted}"
                                        Content="{Binding Name}"
                                        Command="{Binding $parent[Window].((editTrack:EditTrackDialogViewModel)DataContext).TakeCommand}"
                                        CommandParameter="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <TextBlock Text="{CompiledBinding Problem}"
                       IsVisible="{CompiledBinding HasProblem}"
                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                       TextWrapping="Wrap"
                       FontSize="12" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="{x:Static res:UiStrings.Discovery_FieldArtist}" />
            <TextBox AutomationProperties.AutomationId="edit-track.artist"
                     AutomationProperties.Name="{x:Static res:UiStrings.Discovery_FieldArtist}"
                     Text="{CompiledBinding Artist}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="{x:Static res:UiStrings.Discovery_FieldTitle}" />
            <TextBox AutomationProperties.AutomationId="edit-track.title"
                     AutomationProperties.Name="{x:Static res:UiStrings.Discovery_FieldTitle}"
                     Text="{CompiledBinding Title}" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Text="{x:Static res:UiStrings.EditTrack_Likelihood}" />
            <Grid ColumnDefinitions="*,Auto">
                <Slider Grid.Column="0"
                        AutomationProperties.AutomationId="edit-track.likelihood"
                        AutomationProperties.Name="{x:Static res:UiStrings.EditTrack_Likelihood}"
                        Minimum="{x:Static editTrack:EditTrackDialogViewModel.LowestStep}"
                        Maximum="{x:Static editTrack:EditTrackDialogViewModel.HighestStep}"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        TickPlacement="BottomRight"
                        Value="{CompiledBinding LikelihoodStep}"
                        VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           AutomationProperties.AutomationId="edit-track.likelihood-value"
                           Text="{CompiledBinding LikelihoodText}"
                           MinWidth="40"
                           TextAlignment="Right"
                           VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{x:Static res:UiStrings.EditTrack_LikelihoodHint}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Opacity="0.7" />
        </StackPanel>

        <StackPanel Spacing="4">
            <Grid ColumnDefinitions="*,Auto">
                <CheckBox Grid.Column="0"
                          AutomationProperties.AutomationId="edit-track.own-equalizer"
                          Content="{x:Static res:UiStrings.EditTrack_OwnEqualizer}"
                          IsChecked="{CompiledBinding UseOwnEqualizer}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button AutomationProperties.AutomationId="edit-track.copy-equalizer"
                            Content="{x:Static res:UiStrings.EditTrack_CopyEqualizer}"
                            Click="OnCopyEqualizer" />
                    <Button AutomationProperties.AutomationId="edit-track.paste-equalizer"
                            Content="{x:Static res:UiStrings.EditTrack_PasteEqualizer}"
                            Click="OnPasteEqualizer" />
                </StackPanel>
            </Grid>

            <!-- The same bands, preamp and low cut as the panel on the main screen, so a curve
                 pulled there during a dance reads back here as it was left. -->
            <StackPanel Spacing="4" IsEnabled="{CompiledBinding UseOwnEqualizer}">
                <ItemsControl AutomationProperties.AutomationId="edit-track.equalizer-bands"
                              ItemsSource="{CompiledBinding EqualizerBands}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="equalizer:EqualizerBandViewModel">
                            <StackPanel HorizontalAlignment="Center">
                                <Slider AutomationProperties.AutomationId="edit-track.equalizer-band"
                                        AutomationProperties.Name="{CompiledBinding Label}"
                                        Orientation="Vertical"
                                        Height="100"
                                        HorizontalAlignment="Center"
                                        Minimum="{x:Static settings:EqualizerSettings.MinimumGainDecibels}"
                                        Maximum="{x:Static settings:EqualizerSettings.MaximumGainDecibels}"
                                        TickFrequency="3"
                                        TickPlacement="Outside"
                                        Value="{CompiledBinding Gain}"
                                        ToolTip.Tip="{CompiledBinding Gain, StringFormat={}{0:+0.0;-0.0;0.0} dB}" />
                                <TextBlock Text="{CompiledBinding Label}"
                                           FontSize="11"
                                           Opacity="0.7"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                    <CheckBox Grid.Row="0" Grid.Column="0"
                              AutomationProperties.AutomationId="edit-track.equalizer-low-cut-enable"
                              Content="{x:Static res:UiStrings.Equalizer_LowCut}"
                              IsChecked="{CompiledBinding EqualizerLowCutEnabled}"
                              MinWidth="110" />
                    <Slider Grid.Row="0" Grid.Column="1"
                            AutomationProperties.AutomationId="edit-track.equalizer-low-cut-hertz"
                            AutomationProperties.Name="{x:Static res:UiStrings.Equalizer_LowCut}"
                            Minimum="{x:Static settings:EqualizerSettings.MinimumLowCutHertz}"
                            Maximum="{x:Static settings:EqualizerSettings.MaximumLowCutHertz}"
                            Value="{CompiledBinding EqualizerLowCutHertz}"
                            IsEnabled="{CompiledBinding EqualizerLowCutEnabled}"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="{CompiledBinding EqualizerLowCutHertz, StringFormat={}{0:0} Hz}"
                               VerticalAlignment="Center"
                               MinWidth="52"
                               TextAlignment="Right" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="{x:Static res:UiStrings.Equalizer_Preamp}"
                               VerticalAlignment="Center" />
                    <Slider Grid.Row="1" Grid.Column="1"
                            AutomationProperties.AutomationId="edit-track.equalizer-preamp"
                            AutomationProperties.Name="{x:Static res:UiStrings.Equalizer_Preamp}"
                            Minimum="{x:Static settings:EqualizerSettings.MinimumGainDecibels}"
                            Maximum="{x:Static settings:EqualizerSettings.MaximumGainDecibels}"
                            Value="{CompiledBinding EqualizerPreamp}"
                            VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Grid.Column="2"
                               Text="{CompiledBinding EqualizerPreamp, StringFormat={}{0:+0.0;-0.0;0.0} dB}"
                               VerticalAlignment="Center"
                               MinWidth="52"
                               TextAlignment="Right" />
                </Grid>
            </StackPanel>

            <TextBlock AutomationProperties.AutomationId="edit-track.equalizer-problem"
                       Text="{CompiledBinding EqualizerProblem}"
                       IsVisible="{CompiledBinding HasEqualizerProblem}"
                       Foreground="{DynamicResource SystemControlErrorTextForegroundBrush}"
                       TextWrapping="Wrap"
                       FontSize="12" />
            <TextBlock Text="{x:Static res:UiStrings.EditTrack_OwnEqualizerHint}"
                       TextWrapping="Wrap"
                       FontSize="12"
                       Opacity="0.7" />
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,8,0,0">
            <Button AutomationProperties.AutomationId="edit-track.cancel"
                    Content="{x:Static res:UiStrings.Dialog_Cancel}"
                    Command="{CompiledBinding CancelCommand}"
                    MinWidth="80"
                    IsCancel="True" />
            <!-- The accent class comes from FluentTheme at runtime, so these are false positives. -->
            <!-- ReSharper disable once Xaml.StyleClassNotFound -->
            <Button AutomationProperties.AutomationId="edit-track.save"
                    Content="{x:Static res:UiStrings.Dialog_OK}"
                    Command="{CompiledBinding SaveCommand}"
                    MinWidth="80"
                    Classes="accent"
                    IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
