<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Ready4Balfolk.UI.Views.Toolbar"
             xmlns:res="using:Ready4Balfolk.UI.Resources"
             xmlns:controls="using:Ready4Balfolk.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="40"
             x:Class="Ready4Balfolk.UI.Views.Toolbar.ToolbarView"
             x:DataType="local:ToolbarViewModel">
    <StackPanel Orientation="Horizontal" Spacing="4">
        <Button AutomationProperties.AutomationId="toolbar.exit"
                Click="OnExitClick"
                ToolTip.Tip="{x:Static res:UiStrings.Toolbar_Exit}"
                Padding="8"
                Focusable="False">
            <controls:ButtonContent Icon="{StaticResource IconLogin}"
                                    Text="{x:Static res:UiStrings.Toolbar_ExitLabel}"
                                    IconSize="16" />
        </Button>

        <Rectangle Width="1" Fill="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,4" />

        <Button AutomationProperties.AutomationId="toolbar.help"
                Click="OnHelpClick"
                ToolTip.Tip="{x:Static res:UiStrings.Toolbar_Help}"
                Padding="8"
                Focusable="False">
            <controls:ButtonContent Icon="{StaticResource IconHelp}"
                                    Text="{x:Static res:UiStrings.Toolbar_HelpLabel}"
                                    IconSize="16" />
        </Button>
        <Button AutomationProperties.AutomationId="toolbar.settings"
                Click="OnSettingsClick"
                ToolTip.Tip="{x:Static res:UiStrings.Toolbar_Settings}"
                Padding="8"
                Focusable="False">
            <controls:ButtonContent Icon="{StaticResource IconSettings}"
                                    Text="{x:Static res:UiStrings.Toolbar_SettingsLabel}"
                                    IconSize="16" />
        </Button>
        <Button AutomationProperties.AutomationId="toolbar.review"
                Click="OnReviewClick"
                ToolTip.Tip="{x:Static res:UiStrings.Toolbar_Review}"
                Padding="8"
                Focusable="False">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <!-- A tick, not the book the tagging button carries: with button text off, two
                     identical icons side by side are two buttons nobody can tell apart. -->
                <controls:ButtonContent Icon="{StaticResource IconCheck}"
                                        Text="{x:Static res:UiStrings.Toolbar_ReviewLabel}"
                                        IconSize="16" />
                <!-- What is waiting for a person. A count, and only when there is one: nothing here
                     interrupts a room. -->
                <Border IsVisible="{Binding HasInReview}"
                        Background="{DynamicResource SystemAccentColor}"
                        CornerRadius="8"
                        Padding="6,1">
                    <TextBlock Text="{Binding InReviewCount}" FontSize="11" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
