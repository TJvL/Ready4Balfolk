<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Ready4Balfolk.UI.Views.Toolbar"
             xmlns:res="using:Ready4Balfolk.UI.Resources"
             xmlns:controls="using:Ready4Balfolk.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="40"
             x:Class="Ready4Balfolk.UI.Views.Toolbar.ToolbarView"
             x:DataType="local:ToolbarViewModel">
    <StackPanel Orientation="Horizontal" Spacing="4">
        <Button AutomationProperties.AutomationId="toolbar.exit"
                Click="OnExitClick"
                ToolTip.Tip="{x:Static res:UiStrings.Toolbar_Exit}"
                Padding="8"
                Focusable="False">
            <controls:ButtonContent Icon="{StaticResource IconLogin}"
                                    Text="{x:Static res:UiStrings.Toolbar_ExitLabel}"
                                    IconSize="16" />
        </Button>

        <Rectangle Width="1" Fill="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,4" />

        <Button AutomationProperties.AutomationId="toolbar.help"
                Click="OnHelpClick"
                ToolTip.Tip="{x:Static res:UiStrings.Toolbar_Help}"
                Padding="8"
                Focusable="False">
            <controls:ButtonContent Icon="{StaticResource IconHelp}"
                                    Text="{x:Static res:UiStrings.Toolbar_HelpLabel}"
                                    IconSize="16" />
        </Button>
        <Button AutomationProperties.AutomationId="toolbar.settings"
                Click="OnSettingsClick"
                ToolTip.Tip="{x:Static res:UiStrings.Toolbar_Settings}"
                Padding="8"
                Focusable="False">
            <controls:ButtonContent Icon="{StaticResource IconSettings}"
                                    Text="{x:Static res:UiStrings.Toolbar_SettingsLabel}"
                                    IconSize="16" />
        </Button>
        <Button AutomationProperties.AutomationId="toolbar.review"
                Click="OnReviewClick"
                ToolTip.Tip="{x:Static res:UiStrings.Toolbar_Review}"
                Padding="8"
                Focusable="False">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <!-- A tick, not the book the tagging button carries: with button text off, two
                     identical icons side by side are two buttons nobody can tell apart. -->
                <controls:ButtonContent Icon="{StaticResource IconCheck}"
                                        Text="{x:Static res:UiStrings.Toolbar_ReviewLabel}"
                                        IconSize="16" />
                <!-- What is waiting for a person. A count, and only when there is one: nothing here
                     interrupts a room. -->
                <Border IsVisible="{Binding HasInReview}"
                        Background="{DynamicResource SystemAccentColor}"
                        CornerRadius="8"
                        Padding="6,1">
                    <TextBlock Text="{Binding InReviewCount}" FontSize="11" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
        </Button>

        <!-- What the library is keeping but cannot reach. Not a button: there is nothing to press,
             only something to know, and it goes away by itself when the files come back. -->
        <Border AutomationProperties.AutomationId="toolbar.unavailable"
                IsVisible="{Binding HasUnavailable}"
                ToolTip.Tip="{x:Static res:UiStrings.Toolbar_UnavailableTip}"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8,2"
                VerticalAlignment="Center">
            <TextBlock Text="{Binding UnavailableText}" FontSize="11" FontWeight="SemiBold" />
        </Border>

        <!-- What is being served, and how a phone gets to it. Only while it is actually being
             served: a toolbar that said "remote" over a server that never bound would send a hall
             to an address nothing answers. -->
        <Button AutomationProperties.AutomationId="toolbar.display-served"
                Click="OnDisplayAddressClick"
                IsVisible="{Binding IsServingDisplay}"
                ToolTip.Tip="{x:Static res:UiStrings.Toolbar_DisplayServedTip}"
                Padding="8"
                Focusable="False">
            <controls:ButtonContent Icon="{StaticResource IconMonitor}"
                                    Text="{x:Static res:UiStrings.Toolbar_DisplayServed}"
                                    IconSize="16" />
        </Button>
        <Button AutomationProperties.AutomationId="toolbar.remote-served"
                Click="OnRemoteAddressClick"
                IsVisible="{Binding IsServingRemote}"
                ToolTip.Tip="{x:Static res:UiStrings.Toolbar_RemoteServedTip}"
                Padding="8"
                Focusable="False">
            <controls:ButtonContent Icon="{StaticResource IconPhone}"
                                    Text="{x:Static res:UiStrings.Toolbar_RemoteServed}"
                                    IconSize="16" />
        </Button>
    </StackPanel>
</UserControl>
