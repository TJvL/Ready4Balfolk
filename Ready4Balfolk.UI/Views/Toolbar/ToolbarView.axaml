<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Ready4Balfolk.UI.Views.Toolbar"
             xmlns:res="using:Ready4Balfolk.UI.Resources"
             xmlns:controls="using:Ready4Balfolk.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="40"
             x:Class="Ready4Balfolk.UI.Views.Toolbar.ToolbarView"
             x:DataType="local:ToolbarViewModel">
    <StackPanel Orientation="Horizontal" Spacing="4">
        <Button Click="OnExitClick"
                ToolTip.Tip="{x:Static res:UiStrings.Toolbar_Exit}"
                Padding="8"
                Focusable="False">
            <controls:ButtonContent Icon="{StaticResource IconLogin}"
                                    Text="{x:Static res:UiStrings.Toolbar_ExitLabel}"
                                    IconSize="16" />
        </Button>

        <Rectangle Width="1" Fill="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,4" />

        <Button Click="OnHelpClick"
                ToolTip.Tip="{x:Static res:UiStrings.Toolbar_Help}"
                Padding="8"
                Focusable="False">
            <controls:ButtonContent Icon="{StaticResource IconHelp}"
                                    Text="{x:Static res:UiStrings.Toolbar_HelpLabel}"
                                    IconSize="16" />
        </Button>
        <Button Click="OnSettingsClick"
                ToolTip.Tip="{x:Static res:UiStrings.Toolbar_Settings}"
                Padding="8"
                Focusable="False">
            <controls:ButtonContent Icon="{StaticResource IconSettings}"
                                    Text="{x:Static res:UiStrings.Toolbar_SettingsLabel}"
                                    IconSize="16" />
        </Button>
        <Button Click="OnTaggingClick"
                ToolTip.Tip="{x:Static res:UiStrings.Toolbar_Tagging}"
                Padding="8"
                Focusable="False">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <controls:ButtonContent Icon="{StaticResource IconBook}"
                                        Text="{x:Static res:UiStrings.Toolbar_TaggingLabel}"
                                        IconSize="16" />
                <!-- A count, and only when there is one. Nothing here interrupts. -->
                <Border IsVisible="{Binding HasUnresolved}"
                        Background="{DynamicResource SystemAccentColor}"
                        CornerRadius="8"
                        Padding="6,1">
                    <TextBlock Text="{Binding UnresolvedCount}" FontSize="11" FontWeight="SemiBold" />
                </Border>
            </StackPanel>
        </Button>
    </StackPanel>
</UserControl>
