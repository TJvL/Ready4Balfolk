<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:Ready4Balfolk.UI.Views.Presentation"
        xmlns:res="using:Ready4Balfolk.UI.Resources"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="Ready4Balfolk.UI.Views.Presentation.PresentationWindow"
        x:DataType="local:PresentationDisplayViewModel"
        Title="{x:Static res:UiStrings.Presentation_WindowTitleDefault}"
        Background="{DynamicResource PresentationGroundBrush}"
        MinWidth="400" MinHeight="300"
        Width="800" Height="600">

    <!--A fixed palette rather than the theme's: a projector in a dark hall is the same room whether
        the desk runs light or dark. Named once here, and kept in step with the web display's
        colours in app.css.-->
    <Window.Resources>
        <SolidColorBrush x:Key="PresentationGroundBrush" Color="#1a1a1a" />
        <SolidColorBrush x:Key="PresentationLineBrush" Color="#dddddd" />
        <SolidColorBrush x:Key="PresentationQuietBrush" Color="#888888" />
        <SolidColorBrush x:Key="PresentationProgressBrush" Color="#4CAF50" />
        <SolidColorBrush x:Key="PresentationNextTrackBrush" Color="#bbbbbb" />
        <SolidColorBrush x:Key="PresentationBehindDanceBrush" Color="#cccccc" />
        <SolidColorBrush x:Key="PresentationBehindTrackBrush" Color="#aaaaaa" />
    </Window.Resources>

    <!--The whole screen is drawn on a fixed surface and scaled to whatever the projector is, so
        nothing below depends on the resolution or the aspect the hall turns out to have.-->
    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080" RowDefinitions="*,Auto,*">

            <!--Each half is scaled down when what it holds does not fit, and left alone when it
                does. The sizes below are written for a dance name and a track on one line each;
                wrapping keeps a long one on the screen sideways, and this keeps the wrapped block
                inside its own half rather than over the progress bar or off the bottom edge.-->

            <!-- Current item (top half) -->
            <Viewbox Grid.Row="0"
                     Stretch="Uniform"
                     StretchDirection="DownOnly"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Margin="80,20">
                <!--A Viewbox measures with no width limit, so the line the text wraps at is this
                    one: the 1920 surface less the margin on either side of it.-->
                <Grid Width="1760">
                    <StackPanel IsVisible="{Binding HasCurrentItem}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <!-- Track display (non-message) -->
                        <StackPanel IsVisible="{Binding !IsMessageMode}">
                            <TextBlock AutomationProperties.AutomationId="display.dance"
                                       Text="{Binding CurrentDance}"
                                       Foreground="White"
                                       FontSize="140"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,24" />
                            <!--One line rather than a row of artist, separator and title: a row
                                cannot wrap, and the view model writes the separator so that a
                                track with no title does not end in a dangling dash.-->
                            <TextBlock AutomationProperties.AutomationId="display.track"
                                       Text="{Binding CurrentTrack}"
                                       Foreground="{StaticResource PresentationLineBrush}"
                                       FontSize="72"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Message mode -->
                        <TextBlock IsVisible="{Binding IsMessageMode}"
                                   Text="{Binding CurrentDance}"
                                   Foreground="White"
                                   FontSize="140"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- No current item -->
                    <TextBlock AutomationProperties.AutomationId="display.idle"
                               IsVisible="{Binding !HasCurrentItem}"
                               Text="{x:Static res:UiStrings.Presentation_NoTrackPlaying}"
                               Foreground="{StaticResource PresentationQuietBrush}"
                               FontSize="96"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Grid>
            </Viewbox>

            <!-- Progress bar and remaining time (middle) -->
            <Grid Grid.Row="1" VerticalAlignment="Center" Margin="80,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0"
                             Minimum="0"
                             Maximum="{Binding Duration.TotalSeconds}"
                             Value="{Binding Progress.TotalSeconds}"
                             Foreground="{StaticResource PresentationProgressBrush}"
                             Height="24"
                             IsVisible="{Binding HasCurrentItem}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding CurrentTimeLeft}"
                           Foreground="White"
                           FontSize="60"
                           FontWeight="Bold"
                           Margin="32,0,0,0"
                           IsVisible="{Binding HasCurrentItem}" />
            </Grid>

            <!-- Next item (bottom half) -->
            <Viewbox Grid.Row="2"
                     Stretch="Uniform"
                     StretchDirection="DownOnly"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Margin="80,20">
                <Grid Width="1760">
                    <StackPanel IsVisible="{Binding HasNextItem}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <TextBlock Text="{x:Static res:UiStrings.Presentation_Next}"
                                   Foreground="{StaticResource PresentationQuietBrush}"
                                   FontSize="56"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16" />
                        <TextBlock AutomationProperties.AutomationId="display.next-dance"
                                   Text="{Binding NextDance}"
                                   Foreground="{StaticResource PresentationLineBrush}"
                                   FontSize="96"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />
                        <TextBlock AutomationProperties.AutomationId="display.next-track"
                                   Text="{Binding NextTrack}"
                                   Foreground="{StaticResource PresentationNextTrackBrush}"
                                   FontSize="56"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />

                        <!-- What the pause is for. Under the delay rather than instead of it: the
                             room is being told to make lines, and this is what for. -->
                        <StackPanel IsVisible="{Binding HasBehindItem}"
                                    HorizontalAlignment="Center"
                                    Margin="0,20,0,0">
                            <TextBlock Text="{x:Static res:UiStrings.Presentation_Then}"
                                       Foreground="{StaticResource PresentationQuietBrush}"
                                       FontSize="40"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8" />
                            <TextBlock AutomationProperties.AutomationId="display.behind-dance"
                                       Text="{Binding BehindDance}"
                                       Foreground="{StaticResource PresentationBehindDanceBrush}"
                                       FontSize="72"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />
                            <TextBlock AutomationProperties.AutomationId="display.behind-track"
                                       Text="{Binding BehindTrack}"
                                       Foreground="{StaticResource PresentationBehindTrackBrush}"
                                       FontSize="44"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <!-- No next item -->
                    <TextBlock AutomationProperties.AutomationId="display.no-next"
                               IsVisible="{Binding !HasNextItem}"
                               Text="{x:Static res:UiStrings.Presentation_NoNextTrack}"
                               Foreground="{StaticResource PresentationQuietBrush}"
                               FontSize="64"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Grid>
            </Viewbox>
        </Grid>
    </Viewbox>
</Window>
