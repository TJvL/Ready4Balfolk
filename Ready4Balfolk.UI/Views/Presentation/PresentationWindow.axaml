<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="using:Ready4Balfolk.UI.Views.Presentation"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:res="using:Ready4Balfolk.UI.Resources"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="Ready4Balfolk.UI.Views.Presentation.PresentationWindow"
        x:DataType="local:PresentationDisplayViewModel"
        Title="Presentation Display"
        Background="#1a1a1a"
        MinWidth="400" MinHeight="300"
        Width="800" Height="600">

    <Viewbox Stretch="Uniform">
        <Grid Width="1920" Height="1080" RowDefinitions="*,Auto,*">

            <!-- Current item (top half) -->
            <Grid Grid.Row="0" VerticalAlignment="Center" Margin="80,20">
                <StackPanel IsVisible="{Binding HasCurrentItem}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <!-- Track display (non-message) -->
                    <StackPanel IsVisible="{Binding !IsMessageMode}">
                        <TextBlock AutomationProperties.AutomationId="display.dance"
                                   Text="{Binding CurrentDance}"
                                   Foreground="White"
                                   FontSize="140"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,24" />
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center">
                            <TextBlock AutomationProperties.AutomationId="display.artist"
                                       Text="{Binding CurrentArtist}"
                                       Foreground="#dddddd"
                                       FontSize="72" />
                            <TextBlock Text=" - "
                                       Foreground="#cccccc"
                                       FontSize="72"
                                       IsVisible="{Binding CurrentTitle, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock AutomationProperties.AutomationId="display.title"
                                       Text="{Binding CurrentTitle}"
                                       Foreground="#bbbbbb"
                                       FontSize="72" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Message mode -->
                    <TextBlock IsVisible="{Binding IsMessageMode}"
                               Text="{Binding CurrentDance}"
                               Foreground="White"
                               FontSize="140"
                               FontWeight="Bold"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>

                <!-- No current item -->
                <TextBlock AutomationProperties.AutomationId="display.idle"
                           IsVisible="{Binding !HasCurrentItem}"
                           Text="{x:Static res:UiStrings.Presentation_NoTrackPlaying}"
                           Foreground="#666666"
                           FontSize="96"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Progress bar and remaining time (middle) -->
            <Grid Grid.Row="1" VerticalAlignment="Center" Margin="80,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>
                <ProgressBar Grid.Column="0"
                             Minimum="0"
                             Maximum="{Binding Duration.TotalSeconds}"
                             Value="{Binding Progress.TotalSeconds}"
                             Foreground="#4CAF50"
                             Height="24"
                             IsVisible="{Binding HasCurrentItem}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding CurrentTimeLeft}"
                           Foreground="White"
                           FontSize="60"
                           FontWeight="Bold"
                           Margin="32,0,0,0"
                           IsVisible="{Binding HasCurrentItem}" />
            </Grid>

            <!-- Next item (bottom half) -->
            <Grid Grid.Row="2" VerticalAlignment="Center" Margin="80,20">
                <StackPanel IsVisible="{Binding HasNextItem}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <TextBlock Text="{x:Static res:UiStrings.Presentation_Next}"
                               Foreground="#888888"
                               FontSize="56"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,16" />
                    <TextBlock AutomationProperties.AutomationId="display.next-dance"
                                   Text="{Binding NextDance}"
                               Foreground="#dddddd"
                               FontSize="96"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <TextBlock Text="{Binding NextArtist}"
                                   Foreground="#bbbbbb"
                                   FontSize="56" />
                        <TextBlock Text=" - "
                                   Foreground="#aaaaaa"
                                   FontSize="56"
                                   IsVisible="{Binding NextTitle, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock AutomationProperties.AutomationId="display.next-title"
                                   Text="{Binding NextTitle}"
                                   Foreground="#999999"
                                   FontSize="56" />
                    </StackPanel>
                </StackPanel>

                <!-- No next item -->
                <TextBlock AutomationProperties.AutomationId="display.no-next"
                           IsVisible="{Binding !HasNextItem}"
                           Text="{x:Static res:UiStrings.Presentation_NoNextTrack}"
                           Foreground="#444444"
                           FontSize="64"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Viewbox>
</Window>
