<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Ready4Balfolk.UI.Views.TrackCatalog"
             xmlns:res="using:Ready4Balfolk.UI.Resources"
             xmlns:controls="using:Ready4Balfolk.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Ready4Balfolk.UI.Views.TrackCatalog.TrackCatalogView"
             x:DataType="local:TrackCatalogViewModel">
    <controls:LoadingContainer IsLoading="{Binding IsLoading}">
    <Panel>
    <DataGrid
        x:Name="TracksDataGrid"
        AutomationProperties.AutomationId="catalog.tracks"
        ItemsSource="{Binding Tracks}"
        SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
        AutoGenerateColumns="False"
        IsReadOnly="True"
        CanUserReorderColumns="True"
        CanUserResizeColumns="True"
        CanUserSortColumns="True"
        GridLinesVisibility="None"
        SelectionMode="Single"
        Sorting="DataGridSorting"
        DoubleTapped="DataGridDoubleTapped">
        <DataGrid.ContextMenu>
            <ContextMenu>
                <MenuItem AutomationProperties.AutomationId="catalog.edit-track"
                          Header="{x:Static res:UiStrings.TrackCatalog_EditTrack}"
                          Command="{Binding EditTrackCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconPencil}" Width="14" Height="14" />
                    </MenuItem.Icon>
                </MenuItem>
                <!-- Beside the pencil, because the two answer the same complaint: this is wrong,
                     and either I know what it should say or I want to be asked about it again.
                     The lasting way back from an answer, since the review queue drops a track the
                     moment it is in the library and the row that gave the answer is gone by the
                     next scan. -->
                <MenuItem AutomationProperties.AutomationId="catalog.withdraw"
                          Header="{x:Static res:UiStrings.TrackCatalog_WithdrawTrack}"
                          ToolTip.Tip="{x:Static res:UiStrings.TrackCatalog_WithdrawTrackHint}"
                          Command="{Binding WithdrawTrackCommand}">
                    <MenuItem.Icon>
                        <PathIcon Data="{StaticResource IconClose}" Width="14" Height="14" />
                    </MenuItem.Icon>
                </MenuItem>
            </ContextMenu>
        </DataGrid.ContextMenu>
        <DataGrid.Styles>
            <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="DataGridCell:current /template/ Grid#FocusVisual">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="DataGridCell">
                <Setter Property="BorderThickness" Value="0" />
                <!-- Set here rather than on the DataGrid: the cell template applies its own font
                     size, so an inherited value from the grid never reaches the text. -->
                <Setter Property="FontSize" Value="18" />
            </Style>
            <Style Selector="DataGridColumnHeader">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="SeparatorBrush" Value="Transparent" />
                <Setter Property="AreSeparatorsVisible" Value="False" />
            </Style>
            <Style Selector="DataGridRow">
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </DataGrid.Styles>
        <DataGrid.Columns>
            <DataGridTextColumn Binding="{ReflectionBinding Dance}"
                                SortMemberPath="Dance"
                                Width="*">
                <DataGridTextColumn.Header>
                    <TextBlock AutomationProperties.AutomationId="catalog.column-dance"
                               Text="{x:Static res:UiStrings.TrackCatalog_ColumnDance}" />
                </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <DataGridTextColumn Binding="{ReflectionBinding Artist}"
                                SortMemberPath="Artist"
                                Width="*">
                <DataGridTextColumn.Header>
                    <TextBlock AutomationProperties.AutomationId="catalog.column-artist"
                               Text="{x:Static res:UiStrings.TrackCatalog_ColumnArtist}" />
                </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <DataGridTextColumn Binding="{ReflectionBinding Title}"
                                SortMemberPath="Title"
                                Width="2*">
                <DataGridTextColumn.Header>
                    <TextBlock AutomationProperties.AutomationId="catalog.column-title"
                               Text="{x:Static res:UiStrings.TrackCatalog_ColumnTitle}" />
                </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <DataGridTemplateColumn SortMemberPath="Format"
                                    Width="36">
                <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                        <PathIcon Width="20" Height="14"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="{ReflectionBinding Format, Converter={x:Static local:AudioFormatToIconConverter.Instance}}"
                                  Foreground="{ReflectionBinding Format, Converter={x:Static local:AudioFormatToBrushConverter.Instance}}" />
                    </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
            </DataGridTemplateColumn>
            <DataGridTextColumn Binding="{ReflectionBinding LengthFormatted}"
                                SortMemberPath="Track.Length"
                                Width="100">
                <DataGridTextColumn.Header>
                    <TextBlock AutomationProperties.AutomationId="catalog.column-length"
                               Text="{x:Static res:UiStrings.TrackCatalog_ColumnLength}" />
                </DataGridTextColumn.Header>
            </DataGridTextColumn>
        </DataGrid.Columns>
    </DataGrid>

    <!-- What the blank grid means, since it looks the same whether nothing has been found, it is
         all waiting behind review, or a search matched nothing. -->
    <TextBlock AutomationProperties.AutomationId="catalog.empty"
               Text="{Binding EmptyStateText}"
               IsVisible="{Binding EmptyStateText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               MaxWidth="360"
               TextAlignment="Center"
               TextWrapping="Wrap"
               FontSize="16"
               Opacity="0.7"
               IsHitTestVisible="False" />
    </Panel>
    </controls:LoadingContainer>
</UserControl>