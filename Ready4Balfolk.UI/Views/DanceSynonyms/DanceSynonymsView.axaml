<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:local="using:Ready4Balfolk.UI.Views.DanceSynonyms"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Ready4Balfolk.UI.Views.DanceSynonyms.DanceSynonymsView"
             x:DataType="local:DanceSynonymsViewModel">
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding RedoCommand}" />
    </UserControl.KeyBindings>
    <Grid RowDefinitions="Auto,*">
        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
            <Button Click="OnBackClick" ToolTip.Tip="Back" Padding="8" Focusable="False">
                <PathIcon Data="{StaticResource IconArrowLeft}"
                          Width="16" Height="16" />
            </Button>
            <TextBlock Text="Dance Synonyms" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"
                       Margin="0,0,16,0" />

            <!-- Undo/Redo -->
            <Button Command="{Binding UndoCommand}"
                    ToolTip.Tip="{Binding UndoTooltip}"
                    Padding="8"
                    IsEnabled="{Binding !IsLocked}"
                    Focusable="False">
                <PathIcon
                    Data="{StaticResource IconUndo}"
                    Width="16" Height="16" />
            </Button>
            <Button Command="{Binding RedoCommand}"
                    ToolTip.Tip="{Binding RedoTooltip}"
                    Padding="8"
                    IsEnabled="{Binding !IsLocked}"
                    Focusable="False">
                <PathIcon
                    Data="{StaticResource IconRedo}"
                    Width="16" Height="16" />
            </Button>

            <Rectangle Width="1" Fill="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,4" />

            <!-- Import/Export -->
            <Button x:Name="ImportButton"
                    ToolTip.Tip="Import synonyms"
                    Padding="8"
                    Click="OnImportClick"
                    IsEnabled="{Binding !IsLocked}"
                    Focusable="False">
                <PathIcon
                    Data="{StaticResource IconFileImport}"
                    Width="16" Height="16" />
            </Button>
            <Button x:Name="ExportButton"
                    ToolTip.Tip="Export synonyms"
                    Padding="8"
                    Click="OnExportClick"
                    Focusable="False">
                <Button.IsEnabled>
                    <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                        <Binding Path="HasEntries" />
                        <Binding Path="!IsLocked" />
                    </MultiBinding>
                </Button.IsEnabled>
                <PathIcon
                    Data="{StaticResource IconFileExport}"
                    Width="16" Height="16" />
            </Button>

            <Rectangle Width="1" Fill="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" Margin="4,4" />

            <!-- Add Line -->
            <Button Command="{Binding AddLineCommand}"
                    ToolTip.Tip="Add new dance"
                    Padding="8"
                    IsEnabled="{Binding !IsLocked}"
                    Focusable="False">
                <PathIcon Data="{StaticResource IconPlus}"
                          Width="16" Height="16" />
            </Button>
        </StackPanel>

        <!-- Entries List (multi-column) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="local:DanceSynonymEntryViewModel">
                        <Border Width="300"
                                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,8,8"
                                IsEnabled="{Binding !IsInteractionDisabled}">
                            <Grid RowDefinitions="Auto,Auto">
                                <!-- Header: Name and action buttons -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                    <!-- Display mode: read-only name -->
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding !IsEditing}" />
                                    <!-- Edit mode: editable name (styled to match TextBlock size) -->
                                    <TextBox Grid.Column="0"
                                             Text="{Binding Name, Mode=TwoWay}"
                                             FontWeight="SemiBold"
                                             FontSize="14"
                                             Watermark="Dance name"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="0"
                                             MinHeight="0"
                                             VerticalAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             IsVisible="{Binding IsEditing}"
                                             AttachedToVisualTree="OnEditTextBoxAttached"
                                             KeyDown="OnEditKeyDown" />
                                    <!-- Action buttons (disabled during synonym adding) -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2"
                                                Margin="8,0,0,0"
                                                IsEnabled="{Binding !IsAddingSynonym}">
                                        <!-- Pencil / Confirm (V) share the same slot -->
                                        <Panel>
                                            <Button Command="{Binding ToggleEditingCommand}"
                                                    ToolTip.Tip="Edit"
                                                    Padding="6"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    IsVisible="{Binding !IsEditing}"
                                                    Focusable="False">
                                                <PathIcon
                                                    Data="{StaticResource IconPencil}"
                                                    Width="14" Height="14" />
                                            </Button>
                                            <Button Command="{Binding ToggleEditingCommand}"
                                                    ToolTip.Tip="Confirm"
                                                    Padding="6"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    IsVisible="{Binding IsEditing}"
                                                    IsEnabled="{Binding Name, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                    Focusable="False">
                                                <PathIcon
                                                    Data="{StaticResource IconCheck}"
                                                    Width="14" Height="14" />
                                            </Button>
                                        </Panel>
                                        <!-- Trash / Cancel (X) share the same slot -->
                                        <Panel>
                                            <Button Command="{Binding DeleteOrCancelCommand}"
                                                    ToolTip.Tip="Delete"
                                                    Padding="6"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    IsVisible="{Binding !IsEditing}"
                                                    Focusable="False">
                                                <PathIcon
                                                    Data="{StaticResource IconDelete}"
                                                    Width="14" Height="14" />
                                            </Button>
                                            <Button Command="{Binding DeleteOrCancelCommand}"
                                                    ToolTip.Tip="Cancel"
                                                    Padding="6"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    IsVisible="{Binding IsEditing}"
                                                    Focusable="False">
                                                <PathIcon
                                                    Data="{StaticResource IconClose}"
                                                    Width="14" Height="14" />
                                            </Button>
                                        </Panel>
                                    </StackPanel>
                                </Grid>

                                <!-- Synonyms WrapPanel -->
                                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                                    <!-- Existing synonyms as tags (disabled during editing/adding) -->
                                    <ItemsControl ItemsSource="{Binding Synonyms}">
                                        <ItemsControl.IsEnabled>
                                            <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                                <Binding Path="IsEditing"
                                                         Converter="{x:Static conv:BoolConverters.Not}" />
                                                <Binding Path="IsAddingSynonym"
                                                         Converter="{x:Static conv:BoolConverters.Not}" />
                                            </MultiBinding>
                                        </ItemsControl.IsEnabled>
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Background="{DynamicResource SystemControlHighlightListAccentLowBrush}"
                                                    CornerRadius="4"
                                                    Padding="8,4"
                                                    Margin="0,0,6,6">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                                        <Button
                                                            Command="{Binding $parent[ItemsControl].((local:DanceSynonymEntryViewModel)DataContext).RemoveSynonymCommand, FallbackValue={x:Null}}"
                                                            CommandParameter="{Binding}"
                                                            Padding="2"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            VerticalAlignment="Center"
                                                            Focusable="False">
                                                            <PathIcon
                                                                Data="{StaticResource IconClose}"
                                                                Width="10" Height="10"
                                                                Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Add synonym inline TextBox (visible when adding) -->
                                    <Border Background="{DynamicResource SystemControlHighlightListAccentLowBrush}"
                                            CornerRadius="4"
                                            Padding="8,4"
                                            Margin="0,0,6,6"
                                            IsVisible="{Binding IsAddingSynonym}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBox Text="{Binding NewSynonymText, Mode=TwoWay}"
                                                     Width="120"
                                                     Watermark="synonym"
                                                     FontSize="12"
                                                     Padding="0"
                                                     MinHeight="0"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     VerticalAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     IsVisible="{Binding IsAddingSynonym}"
                                                     AttachedToVisualTree="OnSynonymTextBoxAttached"
                                                     KeyDown="OnNewSynonymKeyDown" />
                                            <!-- Confirm synonym (V) — enabled only when text has content -->
                                            <Button Command="{Binding ConfirmAddSynonymCommand}"
                                                    ToolTip.Tip="Confirm"
                                                    Padding="2"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    VerticalAlignment="Center"
                                                    IsEnabled="{Binding NewSynonymText, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}"
                                                    Focusable="False">
                                                <PathIcon
                                                    Data="{StaticResource IconCheck}"
                                                    Width="10" Height="10" />
                                            </Button>
                                            <Button Command="{Binding CancelAddSynonymCommand}"
                                                    ToolTip.Tip="Cancel"
                                                    Padding="2"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    VerticalAlignment="Center"
                                                    Focusable="False">
                                                <PathIcon
                                                    Data="{StaticResource IconClose}"
                                                    Width="10" Height="10" />
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- Add synonym button (hidden when editing or adding) -->
                                    <Button Command="{Binding StartAddSynonymCommand}"
                                            ToolTip.Tip="Add synonym"
                                            Padding="6,4"
                                            Margin="0,0,0,6"
                                            Focusable="False">
                                        <Button.IsVisible>
                                            <MultiBinding Converter="{x:Static conv:BoolConverters.And}">
                                                <Binding Path="IsAddingSynonym"
                                                         Converter="{x:Static conv:BoolConverters.Not}" />
                                                <Binding Path="IsEditing"
                                                         Converter="{x:Static conv:BoolConverters.Not}" />
                                            </MultiBinding>
                                        </Button.IsVisible>
                                        <PathIcon Data="{StaticResource IconPlus}"
                                                  Width="12" Height="12" />
                                    </Button>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
