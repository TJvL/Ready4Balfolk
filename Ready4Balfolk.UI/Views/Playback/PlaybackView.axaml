<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="using:Ready4Balfolk.UI.Views.Playback"
             xmlns:res="using:Ready4Balfolk.UI.Resources"
             xmlns:controls="using:Ready4Balfolk.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
             x:Class="Ready4Balfolk.UI.Views.Playback.PlaybackView"
             x:DataType="local:PlaybackViewModel">
    <Grid RowDefinitions="Auto">
        <!-- Audio unavailable message -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                IsVisible="{Binding IsAudioUnavailable}">
            <TextBlock Text="{x:Static res:UiStrings.Playback_AudioUnavailable}"
                       FontSize="16"
                       Opacity="0.6"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

        <!-- Playback Panel at the top -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                IsVisible="{Binding !IsAudioUnavailable}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                <!-- Dance Name (normal mode - not message) -->
                <TextBlock Grid.Row="0"
                           AutomationProperties.AutomationId="playback.dance"
                           Text="{Binding DanceName}"
                           FontSize="18"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,0,0,8"
                           IsVisible="{Binding !IsMessageMode}" />

                <!-- Dance Name (message mode - scrolling) -->
                <!-- A message is as long as the DJ typed it, and it is the one line on this panel
                     the room is reading too, so it slides rather than showing its first half. The
                     height follows the text: a canvas has none of its own, and a number here would
                     be one written for one font at one size. -->
                <Border Grid.Row="0"
                        ClipToBounds="True"
                        HorizontalAlignment="Stretch"
                        Height="{Binding #MessageTextBlock.Bounds.Height}"
                        Margin="0,0,0,8"
                        IsVisible="{Binding IsMessageMode}">
                    <Canvas x:Name="MessageCanvas" ClipToBounds="True">
                        <TextBlock x:Name="MessageTextBlock"
                                   AutomationProperties.AutomationId="playback.message"
                                   Text="{Binding DanceName}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Canvas.Left="0" />
                    </Canvas>
                </Border>

                <!-- Artist and Title on same line (when track loaded) -->
                <Border Grid.Row="1"
                        ClipToBounds="True"
                        HorizontalAlignment="Stretch"
                        Height="{Binding #TrackInfoPanel.Bounds.Height}"
                        Margin="0,0,0,16"
                        IsVisible="{Binding HasTrack}">
                    <Canvas x:Name="TrackInfoCanvas" ClipToBounds="True">
                        <StackPanel x:Name="TrackInfoPanel"
                                    Orientation="Horizontal"
                                    Canvas.Left="0">
                            <!-- One line, written the way the user asked for it. The separator was
                                 a TextBlock of its own when the fields were fixed; it is theirs
                                 now, and so is what happens when a track has no title. -->
                            <TextBlock AutomationProperties.AutomationId="playback.track"
                                       Text="{Binding TrackLine}"
                                       FontSize="16"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Canvas>
                </Border>

                <!-- Placeholder when no track -->
                <TextBlock Grid.Row="1"
                           Text="..."
                           FontSize="16"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,16"
                           IsVisible="{Binding !HasTrack}" />

                <!-- Progress Bar with Time -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,16">
                    <TextBlock Grid.Column="0"
                               Text="{Binding CurrentTime}"
                               VerticalAlignment="Center"
                               MinWidth="38"
                               TextAlignment="Right"
                               Margin="0,0,8,0" />
                    <ProgressBar x:Name="PlaybackProgressBar"
                                 AutomationProperties.AutomationId="playback.progress"
                                 Grid.Column="1"
                                 Minimum="0"
                                 Maximum="{Binding Duration}"
                                 Value="{Binding Progress}"
                                 Height="8"
                                 VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="{Binding TotalTime}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                </Grid>

                <!-- Playback Controls -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="16">
                    <Button AutomationProperties.AutomationId="playback.play-pause"
                            Command="{Binding PlayPauseCommand}"
                            MinWidth="60"
                            Height="40"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Focusable="False">
                        <Panel>
                            <controls:ButtonContent Icon="{StaticResource IconPlay}"
                                    Text="{x:Static res:UiStrings.Playback_PlayLabel}"
                                    IsVisible="{Binding !IsPlaying}" />
                            <controls:ButtonContent Icon="{StaticResource IconPause}"
                                    Text="{x:Static res:UiStrings.Playback_PauseLabel}"
                                    IsVisible="{Binding IsPlaying}" />
                        </Panel>
                    </Button>
                    <Button AutomationProperties.AutomationId="playback.restart"
                            Command="{Binding RestartCommand}"
                            MinWidth="60"
                            Height="40"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="{x:Static res:UiStrings.Playback_RestartTrack}"
                            Focusable="False">
                        <controls:ButtonContent Icon="{StaticResource IconRestart}"
                                    Text="{x:Static res:UiStrings.Playback_RestartLabel}" />
                    </Button>
                    <Button AutomationProperties.AutomationId="playback.skip"
                            Command="{Binding NextOrClearCommand}"
                            MinWidth="60"
                            Height="40"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Focusable="False">
                        <Panel>
                            <!-- Next track icon - shown when queue has items -->
                            <controls:ButtonContent Icon="{StaticResource IconSkipNext}"
                                    Text="{x:Static res:UiStrings.Playback_SkipLabel}"
                                    IsVisible="{Binding ShowNextIcon}" />
                            <!-- Clear/X icon - shown when queue is empty -->
                            <controls:ButtonContent Icon="{StaticResource IconClose}"
                                    Text="{x:Static res:UiStrings.Playback_ClearLabel}"
                                    IsVisible="{Binding !ShowNextIcon}" />
                        </Panel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>