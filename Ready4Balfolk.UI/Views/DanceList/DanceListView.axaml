<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="using:Ready4Balfolk.UI.Resources"
             xmlns:controls="using:Ready4Balfolk.UI.Controls"
             xmlns:danceList="using:Ready4Balfolk.UI.Views.DanceList"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="520"
             x:Class="Ready4Balfolk.UI.Views.DanceList.DanceListView"
             x:DataType="danceList:DanceListViewModel">
    <UserControl.Styles>
        <!-- A tag reads as a chip wherever it appears: in the rail, and on a card. Both put it in
             the pool, so both have to look like the same thing. -->
        <Style Selector="Button.chip">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style Selector="Button.chip.pooled">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
        </Style>
        <Style Selector="Button.chip.dimmed">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="240,12,*" RowDefinitions="Auto,*">
        <!-- Search, over both columns: it narrows the cards, and dims the rail to match -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
              ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBox Grid.Column="0"
                     Text="{CompiledBinding SearchText, Mode=TwoWay}"
                     Watermark="{x:Static res:UiStrings.DanceList_SearchWatermark}" />
            <TextBlock Grid.Column="1"
                       Text="{CompiledBinding SummaryText}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Opacity="0.6"
                       FontSize="12" />
        </Grid>

        <!-- The rail: every tag, sized by how many dances carry it. What is picked here is the
             pool a random pick and the auto-queue draw from. -->
        <Border Grid.Row="1" Grid.Column="0"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <DockPanel Margin="8">
                <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8">
                    <TextBlock Text="{x:Static res:UiStrings.DanceList_TagsHeader}"
                               FontSize="11"
                               Opacity="0.6" />
                    <TextBlock Text="{CompiledBinding PoolDescription}"
                               TextWrapping="Wrap"
                               FontSize="12" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,8,0,0">
                    <Button Command="{CompiledBinding ClearPoolCommand}"
                            IsVisible="{CompiledBinding HasPool}"
                            HorizontalAlignment="Stretch"
                            Padding="8"
                            Focusable="False">
                        <controls:ButtonContent Icon="{StaticResource IconClose}"
                                                Text="{x:Static res:UiStrings.DanceList_ClearPool}"
                                                IconSize="14" />
                    </Button>

                    <Rectangle Height="1" Margin="0,4"
                               Fill="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />

                    <TextBlock Text="{CompiledBinding OriginText}"
                               TextWrapping="Wrap"
                               FontSize="11"
                               Opacity="0.6" />
                    <Button Command="{CompiledBinding UpdateCommand}"
                            IsEnabled="{CompiledBinding !IsUpdating}"
                            ToolTip.Tip="{x:Static res:UiStrings.DanceList_UpdateTip}"
                            HorizontalAlignment="Stretch"
                            Padding="8"
                            Focusable="False">
                        <controls:ButtonContent Icon="{StaticResource IconDownload}"
                                                Text="{x:Static res:UiStrings.DanceList_Update}"
                                                IconSize="14" />
                    </Button>
                    <Button Click="OnUpdateFromFileClick"
                            IsEnabled="{CompiledBinding !IsUpdating}"
                            ToolTip.Tip="{x:Static res:UiStrings.DanceList_UpdateFromFileTip}"
                            HorizontalAlignment="Stretch"
                            Padding="8"
                            Focusable="False">
                        <controls:ButtonContent Icon="{StaticResource IconFileImport}"
                                                Text="{x:Static res:UiStrings.DanceList_UpdateFromFile}"
                                                IconSize="14" />
                    </Button>
                </StackPanel>

                <ScrollViewer>
                    <ItemsControl ItemsSource="{CompiledBinding Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="danceList:TagChipViewModel">
                                <Button Classes="chip"
                                        Classes.pooled="{Binding IsInPool}"
                                        Classes.dimmed="{Binding IsDimmed}"
                                        Margin="0,0,4,4"
                                        FontSize="{Binding Size}"
                                        Command="{Binding $parent[UserControl].((danceList:DanceListViewModel)DataContext).ToggleTagCommand}"
                                        CommandParameter="{Binding Tag}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="{Binding Tag}" />
                                        <TextBlock Text="{Binding Count}" Opacity="0.5" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- The cards: names as equals, the tags they carry, and the dice that asks for this one
             dance whatever the pool is set to. -->
        <Border Grid.Row="1" Grid.Column="2"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                BorderThickness="1"
                CornerRadius="4">
            <controls:LoadingContainer IsLoading="{CompiledBinding IsLoading}">
                <ScrollViewer Padding="8">
                    <ItemsControl ItemsSource="{CompiledBinding Dances}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="danceList:DanceCardViewModel">
                                <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="4,8">
                                    <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding NamesText}"
                                                   FontSize="16"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{Binding TrackCount, StringFormat={x:Static res:UiStrings.DanceList_TrackCount}}"
                                                   IsVisible="{Binding HasTracks}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0"
                                                   FontSize="12"
                                                   Opacity="0.5" />
                                        <TextBlock Grid.Row="0" Grid.Column="1"
                                                   Text="{x:Static res:UiStrings.DanceList_NoTracks}"
                                                   IsVisible="{Binding !HasTracks}"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0"
                                                   FontSize="12"
                                                   Opacity="0.35" />

                                        <Button Grid.Row="0" Grid.Column="2"
                                                Command="{Binding $parent[UserControl].((danceList:DanceListViewModel)DataContext).PickDanceCommand}"
                                                CommandParameter="{Binding Slug}"
                                                IsVisible="{Binding HasTracks}"
                                                ToolTip.Tip="{x:Static res:UiStrings.DanceList_PickThisDance}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="6"
                                                Focusable="False">
                                            <PathIcon Data="{StaticResource IconDice}" Width="16" Height="16" />
                                        </Button>

                                        <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                      ItemsSource="{Binding Tags}"
                                                      IsVisible="{Binding HasTags}"
                                                      Margin="0,4,0,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="x:String">
                                                    <Button Classes="chip"
                                                            Margin="0,0,4,0"
                                                            Content="{Binding}"
                                                            Command="{Binding $parent[UserControl].((danceList:DanceListViewModel)DataContext).ToggleTagCommand}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </controls:LoadingContainer>
        </Border>
    </Grid>
</UserControl>
