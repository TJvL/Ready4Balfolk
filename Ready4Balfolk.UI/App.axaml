<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Ready4Balfolk.UI.Controls"
             x:Class="Ready4Balfolk.UI.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <!-- Stop marker: brighter orange for dark backgrounds -->
                    <SolidColorBrush x:Key="StopMarkerForeground" Color="#FFB74D" />
                    <SolidColorBrush x:Key="StopMarkerBackground" Color="#30FF8C00" />
                    <!-- Delay marker: brighter blue -->
                    <SolidColorBrush x:Key="DelayMarkerForeground" Color="#64B5F6" />
                    <SolidColorBrush x:Key="DelayMarkerBackground" Color="#304169E1" />
                    <!-- Message marker: brighter teal -->
                    <SolidColorBrush x:Key="MessageMarkerForeground" Color="#4DB6AC" />
                    <SolidColorBrush x:Key="MessageMarkerBackground" Color="#3000897B" />
                    <!-- End of the night: brighter violet -->
                    <SolidColorBrush x:Key="EndOfNightMarkerForeground" Color="#B39DDB" />
                    <SolidColorBrush x:Key="EndOfNightMarkerBackground" Color="#305E35B1" />
                    <!-- Auto-track -->
                    <SolidColorBrush x:Key="AutoTrackForeground" Color="#B0B0B0" />
                    <SolidColorBrush x:Key="AutoTrackBackground" Color="#18808080" />
                    <!-- Drop indicator -->
                    <SolidColorBrush x:Key="DropIndicatorBrush" Color="#42A5F5" />
                    <!-- Dance tree marked indicator -->
                    <SolidColorBrush x:Key="MarkedActiveBrush" Color="#42A5F5" />
                    <SolidColorBrush x:Key="MarkedMutedBrush" Color="#3C42A5F5" />
                    <!-- Notification banners -->
                    <SolidColorBrush x:Key="NotificationErrorBrush" Color="#EF5350" />
                    <SolidColorBrush x:Key="NotificationWarningBrush" Color="#FFA726" />
                    <SolidColorBrush x:Key="NotificationInfoBrush" Color="#42A5F5" />
                    <SolidColorBrush x:Key="NotificationTextBrush" Color="White" />
                    <!-- Audio format indicators -->
                    <SolidColorBrush x:Key="FormatMp3Brush" Color="#42A5F5" />
                    <SolidColorBrush x:Key="FormatWavBrush" Color="#AB47BC" />
                    <SolidColorBrush x:Key="FormatFlacBrush" Color="#66BB6A" />
                    <SolidColorBrush x:Key="FormatOggBrush" Color="#FFA726" />
                    <SolidColorBrush x:Key="FormatAifBrush" Color="#26A69A" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <!-- Stop marker: deeper orange for light backgrounds -->
                    <SolidColorBrush x:Key="StopMarkerForeground" Color="#E65100" />
                    <SolidColorBrush x:Key="StopMarkerBackground" Color="#20E65100" />
                    <!-- Delay marker: deeper blue -->
                    <SolidColorBrush x:Key="DelayMarkerForeground" Color="#1565C0" />
                    <SolidColorBrush x:Key="DelayMarkerBackground" Color="#201565C0" />
                    <!-- Message marker: deeper teal -->
                    <SolidColorBrush x:Key="MessageMarkerForeground" Color="#00695C" />
                    <SolidColorBrush x:Key="MessageMarkerBackground" Color="#2000695C" />
                    <!-- End of the night: deeper violet -->
                    <SolidColorBrush x:Key="EndOfNightMarkerForeground" Color="#4527A0" />
                    <SolidColorBrush x:Key="EndOfNightMarkerBackground" Color="#204527A0" />
                    <!-- Auto-track -->
                    <SolidColorBrush x:Key="AutoTrackForeground" Color="#757575" />
                    <SolidColorBrush x:Key="AutoTrackBackground" Color="#15757575" />
                    <!-- Drop indicator -->
                    <SolidColorBrush x:Key="DropIndicatorBrush" Color="#1565C0" />
                    <!-- Dance tree marked indicator -->
                    <SolidColorBrush x:Key="MarkedActiveBrush" Color="#1565C0" />
                    <SolidColorBrush x:Key="MarkedMutedBrush" Color="#3C1565C0" />
                    <!-- Notification banners -->
                    <SolidColorBrush x:Key="NotificationErrorBrush" Color="#D32F2F" />
                    <SolidColorBrush x:Key="NotificationWarningBrush" Color="#F57C00" />
                    <SolidColorBrush x:Key="NotificationInfoBrush" Color="#1976D2" />
                    <SolidColorBrush x:Key="NotificationTextBrush" Color="White" />
                    <!-- Audio format indicators -->
                    <SolidColorBrush x:Key="FormatMp3Brush" Color="#1976D2" />
                    <SolidColorBrush x:Key="FormatWavBrush" Color="#7B1FA2" />
                    <SolidColorBrush x:Key="FormatFlacBrush" Color="#388E3C" />
                    <SolidColorBrush x:Key="FormatOggBrush" Color="#F57C00" />
                    <SolidColorBrush x:Key="FormatAifBrush" Color="#00796B" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <!-- Kept in step with the ShowButtonText setting by App.OnFrameworkInitializationCompleted,
             so every button swaps between its icon and its label at once. -->
        <Style Selector="controls|ButtonContent">
            <Setter Property="ShowText" Value="{DynamicResource ShowButtonText}" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>

        <!-- LoadingContainer template and animations -->
        <Style Selector="controls|LoadingContainer">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Opacity="0"
                                          IsHitTestVisible="False">
                            <ContentPresenter.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.3" Easing="CubicEaseOut" />
                                </Transitions>
                            </ContentPresenter.Transitions>
                        </ContentPresenter>
                        <Border x:Name="PART_LoadingBorder"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="1"
                                IsHitTestVisible="True">
                            <Border.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                                </Transitions>
                            </Border.Transitions>
                            <ProgressBar IsIndeterminate="True"
                                         Width="200"
                                         HorizontalAlignment="Center" />
                        </Border>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="controls|LoadingContainer:not(:loading) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="controls|LoadingContainer:not(:loading) /template/ Border#PART_LoadingBorder">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="controls|LoadingContainer:loading /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="controls|LoadingContainer:loading /template/ Border#PART_LoadingBorder">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
    </Application.Styles>
</Application>