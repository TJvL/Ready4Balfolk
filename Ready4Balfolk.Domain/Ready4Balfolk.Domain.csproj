<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="AsyncAwaitBestPractices" Version="10.0.0" />
      <PackageReference Include="DynamicData" Version="9.4.33" />
      <PackageReference Include="ManagedBass" Version="4.0.2" />
      <PackageReference Include="System.IO.Abstractions" Version="22.2.0" />
      <PackageReference Include="ManagedBass.Fx" Version="4.0.2" />
      <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
      <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
      <PackageReference Include="TagLibSharp" Version="2.3.0" />
    </ItemGroup>

    <ItemGroup>
      <!--The audio internals are internal because they are how the playback service shapes a BASS
          channel rather than a surface anything else calls: the effect chain, and the raw stream
          handles a test needs so it can ask BASS what was actually done to those streams.

          Both test projects, and for the same reason. A settings file saying the preamp is at -6
          proves nothing about what the room hears: only the trim BASS is holding on the stream
          that is playing does, and reading that needs these handles. A scenario driving the real
          panel is the one place that question can be asked end to end.-->
      <InternalsVisibleTo Include="Ready4Balfolk.Tests" />
      <InternalsVisibleTo Include="Ready4Balfolk.E2E" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Update="Resources\DomainStrings.resx">
        <Generator>PublicResXFileCodeGenerator</Generator>
        <LastGenOutput>DomainStrings.Designer.cs</LastGenOutput>
      </EmbeddedResource>
    </ItemGroup>

</Project>
