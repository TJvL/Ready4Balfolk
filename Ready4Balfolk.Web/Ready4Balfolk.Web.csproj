<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!--Static assets are embedded rather than copied to a wwwroot next to the executable:
            flatpak-builder stages a single published directory and nothing else, and a
            self-contained publish should not depend on loose files surviving it.-->
        <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    </PropertyGroup>

    <!--A class library, not a web application: the Avalonia app is the host and starts this on
        demand. FrameworkReference is how a non-web project gets ASP.NET Core.-->
    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Ready4Balfolk.Domain\Ready4Balfolk.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="wwwroot\**" />
    </ItemGroup>

</Project>
