<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <!--xunit.v3 runs under Microsoft.Testing.Platform, whose entry point is the test
            assembly itself. Without this the build fails with "xUnit.net v3 test projects
            must be executable".-->
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <NoWarn>$(NoWarn);CA1707</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.0" />
        <PackageReference Include="NSubstitute" Version="6.2.0" />
        <PackageReference Include="System.IO.Abstractions.TestingHelpers" Version="22.2.0" />
        <PackageReference Include="xunit.v3" Version="4.0.0" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="..\scripts\smoke-test-media\scale.mp3" LogicalName="scale.mp3" />
        <EmbeddedResource Include="..\scripts\smoke-test-media\scale.ogg" LogicalName="scale.ogg" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Ready4Balfolk.Domain\Ready4Balfolk.Domain.csproj" />
      <ProjectReference Include="..\Ready4Balfolk.UI\Ready4Balfolk.UI.csproj" />
      <ProjectReference Include="..\Ready4Balfolk.Web\Ready4Balfolk.Web.csproj" />
    </ItemGroup>

</Project>
